<Window x:Class="SupermarketPos.Wpf.Views.BusinessSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization" xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
 Title="{loc:T Business_Settings}" Style="{StaticResource FormDialogWindow}" WindowStartupLocation="CenterOwner"
 FontSize="{DynamicResource TextSize14}" Background="{StaticResource BgBrush}" SizeToContent="Manual" Width="1220" Height="900" layout:DialogBounds.FitOwner="False"
 FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
 <Window.Resources>
  <Style TargetType="TabItem">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="3" Padding="10,8">
     <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
   <DockPanel><ItemsPresenter DockPanel.Dock="Top"/><Border Background="White" Padding="12" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ScrollViewer></Border></DockPanel>
  </ControlTemplate></Setter.Value></Setter><Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Style="{StaticResource Card}" Margin="20">
  <DockPanel><TextBlock DockPanel.Dock="Top" Text="{loc:T Business_Settings}" Style="{StaticResource H1}" Margin="6,0,6,12"/>
   <Button DockPanel.Dock="Bottom" Content="{loc:T Common_Close}" IsCancel="True" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Margin="6,8,6,0"/>
   <TextBlock DockPanel.Dock="Bottom" x:Name="Status" TextWrapping="Wrap" Margin="6,10" Foreground="{StaticResource AccentBrush}"/>
   <TabControl x:Name="Tabs" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </DockPanel>
 </Border>
</Window>

<UserControl x:Class="SupermarketPos.Wpf.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
             Background="{StaticResource BgBrush}">
    <TabControl Margin="24" SelectedIndex="{Binding CustomerTab}">
    <TabItem Header="{loc:T Customers_Physical}">
    <DockPanel Margin="4">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{loc:T Nav_Customers}" Style="{StaticResource H1}" />
            <TextBlock Text="{loc:T Customers_Search}" Style="{StaticResource FormLabel}" Margin="0,12,0,4" />
            <WrapPanel Margin="0,0,0,6">
                <Button Content="{loc:T Trade_CustomerLedger}" Command="{Binding ViewLedgerCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0"/>
                <Button Content="{loc:T Trade_RepeatSale}" Command="{Binding RepeatSelectedSaleCommand}" Style="{StaticResource GhostButton}"/>
                <Button Content="{loc:T Credit_Manage}" Command="{Binding ManageCreditCommand}" Style="{StaticResource GhostButton}" Margin="6,0,0,0"/>
            </WrapPanel>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Customers_Search}" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />
            <TextBlock Text="{loc:T Trade_BalanceHelp}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Grid layout:PanelHeights.Key="customers">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions><GridSplitter Grid.Row="1" Style="{StaticResource HeightDivider}"/>
            <Border Style="{StaticResource Card}" Padding="8">
                <DataGrid layout:TableLayout.Key="customers" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Customer_Name}" Binding="{Binding Name}" Width="1.5*" MinWidth="72" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Customer_Phone}" Binding="{Binding Phone}" Width="*" MinWidth="66" ElementStyle="{StaticResource TableValue}" />
                        <DataGridTextColumn Header="{loc:T Customer_Email}" Binding="{Binding Email}" Width="1.4*" MinWidth="70" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Customer_Address}" Binding="{Binding Address}" Width="1.3*" MinWidth="66" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Dash_Sales}" Binding="{Binding SaleCount}" Width="0.6*" MinWidth="42" />
                        <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding Total}" Width="*" MinWidth="76" ElementStyle="{StaticResource TableMoney}" />
                        <DataGridTextColumn Header="{loc:T Trade_TotalPaid}" Binding="{Binding Paid}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                        <DataGridTextColumn Header="{loc:T Trade_Balance}" Binding="{Binding Balance}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                        <DataGridTextColumn Header="{loc:T Credit_Available}" Binding="{Binding Credit}" Width="Auto" ElementStyle="{StaticResource TableMoney}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <TextBlock Text="{loc:T Reports_History}" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{loc:T Reports_OpenReceipt}" Command="{Binding OpenReceiptCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="{loc:T Customer_Details}" Command="{Binding EditCustomerCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="{loc:T Trade_ReceivePayment}" Command="{Binding ReceivePaymentCommand}" Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>
                    <DataGrid layout:TableLayout.Key="customer-sales" ItemsSource="{Binding Selected.Sales}" SelectedItem="{Binding SelectedSale}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Reports_ReceiptNo}" Binding="{Binding ReceiptNo}" Width="*" MinWidth="68" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding DateText}" Width="1.2*" MinWidth="82" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Reports_Payment}" Binding="{Binding PaymentText}" Width="*" MinWidth="56"
                                                ElementStyle="{StaticResource TableName}" />
                            <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding TotalText}" Width="*" MinWidth="72" ElementStyle="{StaticResource TableMoney}" />
                            <DataGridTextColumn Header="{loc:T Trade_Balance}" Binding="{Binding BalanceText}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
    </TabItem>
    <TabItem Header="{loc:T Customers_Digital}" Visibility="{Binding DigitalAvailable, Converter={StaticResource BoolToVis}}">
        <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{loc:T Customers_Search}" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="DigitalCustomerSearch" Text="{Binding DigitalSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Digital_CustomerSearch}" AutomationProperties.HelpText="{loc:T Digital_CustomerHelp}" ToolTip="{loc:T Digital_CustomerHelp}"/>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid layout:PanelHeights.Key="digital-customers" MinHeight="{DynamicResource DigitalWorkspaceMinimumHeight}" Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <GridSplitter Grid.Row="1" Style="{StaticResource HeightDivider}"/>
                <Border Style="{StaticResource Card}" Padding="8">
                    <DataGrid layout:TableLayout.Key="digital-customers" ItemsSource="{Binding DigitalCustomers}" SelectedItem="{Binding SelectedDigitalCustomer}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Digital_Recipient}" Binding="{Binding Identifier}" Width="2*" ElementStyle="{StaticResource TableValue}"/>
                            <DataGridTextColumn Header="{loc:T Customer_Name}" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource TableName}"/>
                            <DataGridTextColumn Header="{loc:T Service_Provider}" Binding="{Binding Provider}" Width="*" ElementStyle="{StaticResource TableName}"/>
                            <DataGridTextColumn Header="{loc:T Digital_Transactions}" Binding="{Binding Transactions}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding Last}" Width="1.5*" ElementStyle="{StaticResource TableValue}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Button Content="{loc:T Reports_OpenReceipt}" Command="{Binding OpenDigitalReceiptCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="{loc:T Digital_EditCustomerName}" Command="{Binding EditDigitalNameCommand}" Style="{StaticResource GhostButton}"/>
                        </WrapPanel>
                        <DataGrid layout:TableLayout.Key="digital-customer-history" ItemsSource="{Binding DigitalHistory}" SelectedItem="{Binding SelectedDigitalTransaction}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Service_Receipt}" Binding="{Binding Number}" Width="Auto" ElementStyle="{StaticResource TableValue}"/>
                                <DataGridTextColumn Header="{loc:T Digital_AttemptDate}" Binding="{Binding Date}" Width="Auto" ElementStyle="{StaticResource TableValue}"/>
                                <DataGridTextColumn Header="{loc:T Digital_PostedDate}" Binding="{Binding PostedDate}" Width="Auto" ElementStyle="{StaticResource TableValue}"/>
                                <DataGridTextColumn Header="{loc:T Service_Provider}" Binding="{Binding Provider}" Width="Auto" ElementStyle="{StaticResource TableName}"/>
                                <DataGridTextColumn Header="{loc:T Service_Type}" Binding="{Binding Type}" Width="Auto" ElementStyle="{StaticResource TableName}"/>
                                <DataGridTextColumn Header="{loc:T Service_Principal}" Binding="{Binding Principal}" Width="Auto" ElementStyle="{StaticResource TableMoney}"/>
                                <DataGridTextColumn Header="{loc:T Digital_Fee}" Binding="{Binding Fee}" Width="Auto" ElementStyle="{StaticResource TableMoney}"/>
                                <DataGridTextColumn Header="{loc:T Service_Status}" Binding="{Binding Status}" Width="Auto" ElementStyle="{StaticResource TableName}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </DockPanel>
    </TabItem>
    </TabControl>
</UserControl>

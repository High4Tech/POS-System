<UserControl x:Class="SupermarketPos.Wpf.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
             Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="{loc:T Nav_Customers}" Style="{StaticResource H1}" />
            <TextBlock Text="{loc:T Customers_Search}" Style="{StaticResource FormLabel}" Margin="0,12,0,4" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Customers_Search}" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />
            <TextBlock Text="{loc:T Trade_BalanceHelp}" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <DataGrid layout:TableLayout.Key="customers" ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Customer_Name}" Binding="{Binding Name}" Width="1.5*" MinWidth="72" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Customer_Phone}" Binding="{Binding Phone}" Width="*" MinWidth="66" ElementStyle="{StaticResource TableValue}" />
                        <DataGridTextColumn Header="{loc:T Customer_Email}" Binding="{Binding Email}" Width="1.4*" MinWidth="70" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Customer_Address}" Binding="{Binding Address}" Width="1.3*" MinWidth="66" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Dash_Sales}" Binding="{Binding SaleCount}" Width="0.6*" MinWidth="42" />
                        <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding Total}" Width="*" MinWidth="76" ElementStyle="{StaticResource TableMoney}" />
                        <DataGridTextColumn Header="{loc:T Trade_TotalPaid}" Binding="{Binding Paid}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                        <DataGridTextColumn Header="{loc:T Trade_Balance}" Binding="{Binding Balance}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <TextBlock Text="{loc:T Reports_History}" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{loc:T Reports_OpenReceipt}" Command="{Binding OpenReceiptCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="{loc:T Customer_Details}" Command="{Binding EditCustomerCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <Button Content="{loc:T Trade_ReceivePayment}" Command="{Binding ReceivePaymentCommand}" Style="{StaticResource PrimaryButton}" />
                    </WrapPanel>
                    <DataGrid layout:TableLayout.Key="customer-sales" ItemsSource="{Binding Selected.Sales}" SelectedItem="{Binding SelectedSale}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Reports_ReceiptNo}" Binding="{Binding ReceiptNo}" Width="*" MinWidth="68" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding DateText}" Width="1.2*" MinWidth="82" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Reports_Payment}" Binding="{Binding PaymentText}" Width="*" MinWidth="56"
                                                ElementStyle="{StaticResource TableName}" />
                            <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding TotalText}" Width="*" MinWidth="72" ElementStyle="{StaticResource TableMoney}" />
                            <DataGridTextColumn Header="{loc:T Trade_Balance}" Binding="{Binding BalanceText}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

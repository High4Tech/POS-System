<Window x:Class="SupermarketPos.Wpf.Views.SerialEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        Style="{StaticResource FormDialogWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{loc:T Trade_EnterIdentifiers}" Background="{StaticResource BgBrush}" FontSize="{DynamicResource TextSize14}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}">
        <Border Style="{StaticResource Card}" Width="{DynamicResource PaymentDialogWidth}">
            <StackPanel>
                <TextBlock x:Name="ProductTitle" Style="{StaticResource H1}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:T Trade_SerialHelp}" TextWrapping="Wrap" Margin="0,8,0,12" />
                <TextBox x:Name="Identifiers" AcceptsReturn="True" Height="210" VerticalContentAlignment="Top" FlowDirection="LeftToRight"
                         VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{loc:T Trade_Identifiers}" />
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource StopBrush}" TextWrapping="Wrap" Margin="0,8,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="{loc:T Common_Cancel}" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="{loc:T Trade_SaveUnits}" Style="{StaticResource PrimaryButton}" Click="Save" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>

<UserControl x:Class="SupermarketPos.Wpf.Views.CustomerFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization">
    <StackPanel>
        <CheckBox Content="{loc:T Customer_Include}" IsChecked="{Binding IncludeDetails}" />
        <StackPanel Margin="0,8,0,0" Visibility="{Binding IncludeDetails,Converter={StaticResource BoolToVis}}">
         <TextBlock Text="{loc:T Customer_SelectExisting}" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
         <ComboBox ItemsSource="{Binding ExistingCustomers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Label" IsEditable="True" IsTextSearchEnabled="False" Margin="0,0,0,10"/>
        </StackPanel>
        <Grid Margin="0,8,0,0" Visibility="{Binding IncludeDetails, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="NameLabel" Text="{loc:T Customer_Name}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" />
            <TextBlock x:Name="PhoneLabel" Grid.Column="2" Text="{loc:T Customer_Phone}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" />
            <TextBox Grid.Row="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0,3,0,10"
                     AutomationProperties.LabeledBy="{Binding ElementName=NameLabel}" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                     FlowDirection="LeftToRight" Margin="0,3,0,10" AutomationProperties.LabeledBy="{Binding ElementName=PhoneLabel}" />
            <TextBlock x:Name="EmailLabel" Grid.Row="2" Text="{loc:T Customer_Email}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" />
            <TextBlock x:Name="AddressLabel" Grid.Row="2" Grid.Column="2" Text="{loc:T Customer_Address}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" />
            <TextBox Grid.Row="3" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" FlowDirection="LeftToRight"
                     Margin="0,3,0,0" AutomationProperties.LabeledBy="{Binding ElementName=EmailLabel}" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300"
                     Margin="0,3,0,0" AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}" />
        </Grid>
    </StackPanel>
</UserControl>

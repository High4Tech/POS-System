<Window x:Class="SupermarketPos.Wpf.Views.SerialRecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
        Style="{StaticResource FormDialogWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{loc:T Trade_Devices}" FontSize="{DynamicResource TextSize14}" Background="{StaticResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}">
        <Border Style="{StaticResource Card}" Width="1200">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="ProductTitle" Style="{StaticResource H1}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:T Trade_SearchDevice}" Style="{StaticResource FormLabel}" Margin="0,10,0,4" />
                    <TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="{loc:T Trade_SearchDevice}" />
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource StopBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="RegisterButton" Content="{loc:T Trade_RegisterDevices}" Style="{StaticResource GhostButton}" Click="Register" Margin="0,0,8,0" />
                    <Button Content="{loc:T Common_Close}" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
                    <Button x:Name="SelectButton" Content="{loc:T Trade_UseDevice}" Style="{StaticResource PrimaryButton}" Click="Select" Visibility="Collapsed" />
                </WrapPanel>
                <Grid>
                    <DataGrid x:Name="Devices" layout:TableLayout.Key="serial-warranty-records" IsReadOnly="True" SelectionMode="Single" Height="350">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Pos_Product}" Binding="{Binding ProductName}" Width="1.4*" ElementStyle="{StaticResource TableName}" />
                            <DataGridTextColumn Header="{loc:T Tech_Brand}" Binding="{Binding Brand}" Width="*" ElementStyle="{StaticResource TableName}"/>
                            <DataGridTextColumn Header="{loc:T Tech_Model}" Binding="{Binding Model}" Width="*" ElementStyle="{StaticResource TableName}"/>
                            <DataGridTextColumn Header="{loc:T Trade_Serial}" Binding="{Binding Serial}" Width="*" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Trade_Imei1}" Binding="{Binding Imei1}" Width="*" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Trade_Imei2}" Binding="{Binding Imei2}" Width="*" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Products_Status}" Binding="{Binding Status}" Width="*" ElementStyle="{StaticResource TableName}" />
                            <DataGridTextColumn Header="{loc:T Reports_ReceiptNo}" Binding="{Binding Receipt}" Width="*" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Customer_Name}" Binding="{Binding Customer}" Width="*" ElementStyle="{StaticResource TableName}" />
                            <DataGridTextColumn Header="{loc:T Customer_Phone}" Binding="{Binding Phone}" Width="*" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Trade_SoldDate}" Binding="{Binding SoldOn, StringFormat=d}" Width="*" />
                            <DataGridTextColumn Header="{loc:T Trade_WarrantyUntil}" Binding="{Binding WarrantyUntil, StringFormat=d}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="EmptyText" Text="{loc:T Trade_NoDevices}" TextWrapping="Wrap" HorizontalAlignment="Center"
                               VerticalAlignment="Center" MaxWidth="720" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>
    </Viewbox>
</Window>

<Window Style="{StaticResource CaptionWindow}" x:Class="SupermarketPos.Wpf.Views.RestockWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
        Title="{loc:T Stock_RestockTitle}" Width="880" Height="540" MinWidth="595" MinHeight="385"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="{loc:T Stock_RestockTitle}" Style="{StaticResource H1}" Margin="0,0,0,12" />
        <Button DockPanel.Dock="Bottom" Content="{loc:T Common_Close}" IsCancel="True" HorizontalAlignment="Right"
                Style="{StaticResource GhostButton}" Margin="0,14,0,0" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="265" />
            </Grid.ColumnDefinitions>
            <DataGrid layout:TableLayout.Key="low-stock" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" Margin="0,0,14,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:T Pos_Product}" Binding="{Binding Name}" Width="1.7*" MinWidth="76" ElementStyle="{StaticResource TableName}" />
                    <DataGridTextColumn Header="{loc:T Products_Barcode}" Binding="{Binding Barcode}" Width="*" MinWidth="64" ElementStyle="{StaticResource TableValue}" />
                    <DataGridTextColumn Header="{loc:T Products_Stock}" Binding="{Binding StockQuantity, StringFormat={}{0:0.###}}" Width="0.65*" MinWidth="40" />
                </DataGrid.Columns>
            </DataGrid>
            <Viewbox Grid.Column="1" Style="{StaticResource DialogFit}" VerticalAlignment="Top" Margin="0">
                <Border Style="{StaticResource Card}" Width="265" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="{loc:T Stock_RestockQuantity}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,4,0,10" />
                        <Button Content="{loc:T Products_Restock}" Command="{Binding RestockCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding RestockMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding RestockMessage, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding RestockError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding RestockError, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>
    </DockPanel>
</Window>

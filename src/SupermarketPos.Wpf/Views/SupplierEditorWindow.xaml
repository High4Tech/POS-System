<Window x:Class="SupermarketPos.Wpf.Views.SupplierEditorWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        Style="{StaticResource FormDialogWindow}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}" Margin="18">
        <Border Style="{StaticResource Card}" Width="650" Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource H1}" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:T Purchase_SupplierName}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0,3,0,9" />
                        <TextBlock Text="{loc:T Supplier_Kind}" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding SupplierKinds}" DisplayMemberPath="Name" SelectedValuePath="Code"
                                  SelectedValue="{Binding SupplierKind}" Margin="0,3,0,9" />
                        <TextBlock Text="{loc:T Supplier_Contact}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding SupplierContact, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T Customer_Phone}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding SupplierPhone, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" FlowDirection="LeftToRight" Margin="0,3,0,9" />
                        <TextBlock Text="{loc:T Customer_Email}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding SupplierEmail, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" FlowDirection="LeftToRight" Margin="0,3,0,9" />
                        <TextBlock Text="{loc:T Customer_Address}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding SupplierAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="{Binding Error, Converter={StaticResource StrToVis}}" Margin="0,8,0,0" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="{loc:T Common_Cancel}" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button Content="{loc:T Common_Save}" Command="{Binding SaveSupplierCommand}" Style="{StaticResource PrimaryButton}" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>

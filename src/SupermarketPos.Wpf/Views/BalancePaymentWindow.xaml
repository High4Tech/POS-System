<Window x:Class="SupermarketPos.Wpf.Views.BalancePaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
        Style="{StaticResource FormDialogWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontSize="{DynamicResource TextSize14}"
        Title="{loc:T Trade_Payments}" FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}">
        <Border Style="{StaticResource Card}" Width="{DynamicResource PaymentDialogWidth}">
            <StackPanel>
                <TextBlock Text="{Binding Invoice}" Style="{StaticResource H1}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Party}" TextWrapping="Wrap" Margin="0,4,0,12" />
                <TextBlock Text="{loc:T Trade_Balance}" Style="{StaticResource FormLabel}" />
                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Money}" Margin="0,4,0,8" />
                <TextBlock Text="{Binding InitialText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <DataGrid layout:TableLayout.Key="account-payments" ItemsSource="{Binding Payments}" IsReadOnly="True" Height="180" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Trade_PaymentDate}" Binding="{Binding PaidOn, StringFormat=d}" Width="*" />
                        <DataGridTextColumn Header="{loc:T Trade_Amount}" Binding="{Binding Amount, StringFormat=N2}" Width="*" ElementStyle="{StaticResource TableMoney}" />
                        <DataGridTextColumn Header="{loc:T Trade_Method}" Binding="{Binding MethodText}" Width="*" />
                        <DataGridTextColumn Header="{loc:T Trade_Reference}" Binding="{Binding Reference}" Width="1.5*" />
                        <DataGridTextColumn Header="{loc:T Reports_Cashier}" Binding="{Binding RecordedBy}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:T Trade_Amount}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,4,0,8" />
                        <TextBlock Text="{loc:T Trade_Method}" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding Methods}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Method}" Margin="0,4,0,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:T Trade_PaymentDate}" Style="{StaticResource FormLabel}" />
                        <DatePicker SelectedDate="{Binding PaidOn}" Margin="0,4,0,8" />
                        <TextBlock Text="{loc:T Trade_Reference}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" Margin="0,4,0,8" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource StopBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="{loc:T Common_Close}" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,6,0" />
                    <Button x:Name="SaveButton" Grid.Column="1" Content="{loc:T Trade_Record}" Style="{StaticResource PrimaryButton}" Click="Save" Margin="6,0,0,0" />
                </Grid>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>

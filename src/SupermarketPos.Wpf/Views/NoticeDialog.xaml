<Window x:Class="SupermarketPos.Wpf.Views.NoticeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        Style="{StaticResource FormDialogWindow}" ResizeMode="NoResize" ShowInTaskbar="False"
        FontSize="{DynamicResource TextSize14}" Background="{DynamicResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}">
        <Border Width="{DynamicResource CompactDialogWidth}" Padding="14">
            <StackPanel>
                <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,18" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="{loc:T Common_Cancel}" IsCancel="True"
                            Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                    <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Click="Accept" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Viewbox>
</Window>

<UserControl x:Class="SupermarketPos.Wpf.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
             xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"

             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <layout:RegisterTileWidthConverter x:Key="CategoryTileWidth" StandardWidth="162" Gap="9" />
        <layout:RegisterTileWidthConverter x:Key="ProductTileWidth" StandardWidth="186" Gap="12" />
        <Style x:Key="FitAmount" TargetType="Viewbox">
            <Setter Property="StretchDirection" Value="DownOnly" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DropShadowEffect x:Key="ProductHoverShadow" Color="#14273B" BlurRadius="14" ShadowDepth="3"
                          Direction="270" Opacity="0.23" RenderingBias="Performance" />
        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource ProductHoverShadow}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProductCardAction" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="3">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ProductQuantityButton" TargetType="Button">
            <Setter Property="Width" Value="{DynamicResource ProductQuantityButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource ProductQuantityButtonSize}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource RegisterTileIconSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="999" Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="{StaticResource FieldBorder}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{StaticResource FieldSelected}" />
                                <Setter TargetName="Circle" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.45" />
                                <Setter TargetName="Circle" Property="Effect" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.3*" />
            <ColumnDefinition Width="*" MaxWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: search + cart -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <DockPanel DockPanel.Dock="Top" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Visibility="{Binding SearchText,Converter={StaticResource StrToVis}}" Content="{loc:T Pharmacy_UseEnteredName}" Command="{Binding UseMedicineNameCommand}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                <ContentControl Content="{Binding PharmacyWorkspace.Search}"/>
            </DockPanel>
            <ContentControl DockPanel.Dock="Top" MaxHeight="300" Content="{Binding PharmacyWorkspace}" Visibility="{Binding PharmacyWorkspace.HasPendingEntry,Converter={StaticResource BoolToVis},FallbackValue=Collapsed}"/>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="{Binding IsPharmacy,Converter={StaticResource InverseBoolToVis}}">
                <TextBox x:Name="SearchBox" PreviewKeyDown="SearchKey" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="{DynamicResource TextSize16}" Padding="12,7" VerticalAlignment="Stretch">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="{loc:T Pos_ScanPrompt}" Foreground="{StaticResource MutedBrush}"
                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="{DynamicResource TextSize15}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>


            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding IsPharmacy,Converter={StaticResource InverseBoolToVis}}">
              <Button Content="{Binding QuickAddCaption}" Command="{Binding QuickAddProductCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Visibility="{Binding CanQuickAddProduct,Converter={StaticResource BoolToVis}}"/>
              <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding RetailReferenceMatches}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Caption}" Command="{Binding DataContext.UseRetailReferenceCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </StackPanel>
           <Border DockPanel.Dock="Top" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="10"
                    Padding="12" Background="#FFFFFBEB" Margin="0,0,0,10"
                    Visibility="{Binding UnknownBarcode, Converter={StaticResource StrToVis}}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="⚠" Margin="0,0,6,0" />
                        <TextBlock Text="{loc:T Scanner_NotFoundTitle}" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="{Binding UnknownBarcode}" FontFamily="{StaticResource MonoFont}" Margin="0,3,0,3" />
                    <TextBlock Text="{loc:T Scanner_NotFoundHelp}" TextWrapping="Wrap" Margin="0,0,0,7" />
                    <TextBlock Text="{Binding MoreBarcodeNotices}" Margin="0,0,0,7"
                               Visibility="{Binding MoreBarcodeNotices, Converter={StaticResource StrToVis}}" />
                    <WrapPanel>
                        <Button Command="{Binding AddScannedProductCommand}" Content="{loc:T Scanner_AddInventory}"
                                Style="{StaticResource PrimaryButton}" Padding="10,7" Margin="0,0,6,0" />
                        <Button Command="{Binding DismissUnknownCommand}" Content="{loc:T Scanner_Dismiss}"
                                Style="{StaticResource GhostButton}" Padding="10,7" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12,8" Background="#FFFFFBEB" Margin="0,0,0,10"
                    Visibility="{Binding StockWarning, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding StockWarning}" TextWrapping="Wrap" FontWeight="SemiBold"
                           AutomationProperties.LiveSetting="Assertive" />
            </Border>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12" Background="#FFFFFBEB" Margin="0,0,0,10"
                    Visibility="{Binding BatchPrompt.Message, Converter={StaticResource StrToVis}, FallbackValue=Collapsed}">
                <StackPanel>
                    <TextBlock Text="{Binding BatchPrompt.Message}" TextWrapping="Wrap" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Assertive" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding BatchPrompt.Choices}" SelectedItem="{Binding SelectedBatch}" Margin="0,0,0,8"
                              AutomationProperties.Name="{loc:T Batch_Lot}"
                              Visibility="{Binding BatchPrompt.HasChoices, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Lot}" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Margin="0,0,14,0" />
                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:0.###}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <WrapPanel>
                        <Button Content="{loc:T Batch_Confirm}" Command="{Binding ConfirmBatchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                Visibility="{Binding BatchPrompt.HasChoices, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                        <Button Content="{loc:T Batch_Review}" Command="{Binding ReviewBatchInventoryCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                        <Button Content="{loc:T Batch_CancelScan}" Command="{Binding CancelBatchCommand}" Style="{StaticResource GhostButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="CategoryStrip" Tag="{DynamicResource CategoryCardWidth}" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,12" Padding="0,0,0,3" Focusable="False">
                <DockPanel><Button DockPanel.Dock="Left" Content="{loc:T Pos_All}" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="{DynamicResource RegisterTileTextSize}" ContentTemplate="{StaticResource ButtonCaption}" Padding="12,6" Command="{Binding SelectAllCategoryCommand}" Style="{StaticResource TileButton}" Background="{StaticResource AccentBrush}" Foreground="White" MinWidth="80" Margin="0,0,9,0"/><ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Background="{Binding Color}" Foreground="White"
                                    Margin="0,0,9,0" Padding="8"
                                    ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Width>
                                    <MultiBinding Converter="{StaticResource CategoryTileWidth}">
                                        <Binding Path="ViewportWidth" ElementName="CategoryStrip" />
                                        <Binding Path="Tag" ElementName="CategoryStrip" />
                                    </MultiBinding>
                                </Button.Width>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource TileButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel>
                                    <ContentControl Visibility="{Binding DataContext.ShowProductImages,RelativeSource={RelativeSource AncestorType=ItemsControl},Converter={StaticResource BoolToVis}}" Style="{StaticResource CatalogThumbnail}" Background="#24FFFFFF" Height="{DynamicResource CategoryImageHeight}"
                                                    Tag="{Binding ImagePath, Converter={StaticResource PathToImage}, ConverterParameter=420}"
                                                    Content="{Binding Name, Converter={StaticResource Initials}}" FontSize="{DynamicResource RegisterTileIconSize}" />
                                    <Grid MinHeight="{DynamicResource CategoryLabelHeight}" Margin="2,4,2,0">
                                        <TextBlock Text="{Binding Name}" FontFamily="{Binding Name,Converter={StaticResource ProductTextFont}}" Foreground="White" FontWeight="Bold"
                                                   FontSize="{DynamicResource RegisterTileTextSize}" TextAlignment="Center" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl></DockPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RegisterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
            <Grid x:Name="RegisterWorkspace" Height="{Binding ViewportHeight,ElementName=RegisterScroll}" MinHeight="{DynamicResource RegisterWorkspaceMinimumHeight}" layout:PanelHeights.Key="register"><Grid.RowDefinitions><RowDefinition Height="58*" MinHeight="{DynamicResource RegisterCatalogMinimumHeight}"/><RowDefinition Height="12"/><RowDefinition Height="42*" MinHeight="{DynamicResource RegisterCartMinimumHeight}"/></Grid.RowDefinitions><GridSplitter Grid.Row="1" Style="{StaticResource HeightDivider}"/>
<Border Padding="8" Style="{StaticResource Card}"><DockPanel>            <Border DockPanel.Dock="Top" Padding="0,0,0,6">
              <DockPanel>
            <WrapPanel DockPanel.Dock="Right" Margin="0,0,0,10"><ComboBox ItemsSource="{Binding CatalogKinds}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding CatalogKind}" MinWidth="120" Margin="0,0,6,0" Visibility="{Binding IsPharmacy,Converter={StaticResource InverseBoolToVis}}"/><ComboBox ItemsSource="{Binding RegisterSorts}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding RegisterSort}" MinWidth="120" Margin="0,0,6,0"/>
                <Button Content="{loc:T Pos_Cards}" FontSize="{DynamicResource RegisterTileTextSize}" ContentTemplate="{StaticResource ButtonCaption}" Command="{Binding ShowCardsCommand}" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding RegisterList}" Value="False"/><Condition Binding="{Binding IsEnabled,RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
                <Button Content="{loc:T Pos_List}" FontSize="{DynamicResource RegisterTileTextSize}" ContentTemplate="{StaticResource ButtonCaption}" Command="{Binding ShowListCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding RegisterList}" Value="True"/><Condition Binding="{Binding IsEnabled,RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></MultiDataTrigger></Style.Triggers></Style></Button.Style></Button>
            </WrapPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding CollectionTitle}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding CollectionCount}" Style="{StaticResource Muted}"/>
                </StackPanel>
              </DockPanel>
            </Border>
<Grid>                <!-- product tiles for the chosen category / search -->
                <Border DockPanel.Dock="Top" Padding="0" Margin="0">
                    <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Visibility" Value="{Binding ShowRegisterCards,Converter={StaticResource BoolToVis}}"/></Style></Border.Style>
                    <DockPanel><WrapPanel DockPanel.Dock="Bottom" Visibility="{Binding HasProductPages,Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center">
                        <Button Content="‹" ContentTemplate="{StaticResource ButtonCaption}" FontFamily="Segoe UI" Command="{Binding PreviousProductsCommand}" FontSize="{DynamicResource RegisterTileTextSize}" Padding="8,3" Style="{StaticResource GhostButton}" AutomationProperties.Name="{loc:T Common_Back}"/>
                        <TextBlock Text="{Binding ProductPageText}" FontFamily="Segoe UI" FontSize="{DynamicResource RegisterTileTextSize}" FlowDirection="LeftToRight" VerticalAlignment="Center" Margin="12,0"/>
                        <Button Content="›" ContentTemplate="{StaticResource ButtonCaption}" FontFamily="Segoe UI" Command="{Binding NextProductsCommand}" FontSize="{DynamicResource RegisterTileTextSize}" Padding="8,3" Style="{StaticResource GhostButton}" AutomationProperties.Name="{loc:T Common_Next}"/>
                    </WrapPanel><ScrollViewer x:Name="ProductResults" Tag="{DynamicResource ProductCardWidth}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CardTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12" Padding="10,10,10,12" CornerRadius="14"
                                            ><Border.Style><Style TargetType="Border" BasedOn="{StaticResource ProductCard}">
<Style.Triggers><DataTrigger Binding="{Binding SearchSelected}" Value="True"><Setter Property="Background" Value="#FFE0EBFF"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers>
</Style></Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource ProductTileWidth}">
                                                <Binding Path="ViewportWidth" ElementName="ProductResults" />
                                                <Binding Path="Tag" ElementName="ProductResults" />
                                            </MultiBinding>
                                        </Border.Width>
                                        <StackPanel>
                                            <Button Style="{StaticResource ProductCardAction}" ToolTip="{Binding Product.Name}"
                                                    AutomationProperties.Name="{Binding Product.Name}"
                                                    Command="{Binding DataContext.AddFromResultsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Product}">
                                                <StackPanel>
                                                    <ContentControl Visibility="{Binding DataContext.ShowProductImages,RelativeSource={RelativeSource AncestorType=ItemsControl},Converter={StaticResource BoolToVis}}" Style="{StaticResource CatalogThumbnail}" Height="{DynamicResource ProductImageHeight}" Margin="0,0,0,7"
                                                                    Background="{Binding Product.Category, Converter={StaticResource CatColor}}"
                                                                    Tag="{Binding Product.ImagePath, Converter={StaticResource PathToImage}, ConverterParameter=460}"
                                                                    Content="{Binding Product.Name, Converter={StaticResource Initials}}" FontSize="{DynamicResource ProductTileInitialsSize}" />
                                                    <TextBlock Text="{Binding Product.Name}" FontFamily="{Binding Product.Name,Converter={StaticResource ProductTextFont}}" FontWeight="SemiBold" FontSize="{DynamicResource RegisterTileTextSize}" TextWrapping="Wrap"
                                                               MinHeight="{DynamicResource ProductLabelHeight}" />
                                                    <TextBlock Text="{Binding PriceText}" FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="{DynamicResource RegisterTileTextSize}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel TextElement.FontSize="{DynamicResource RegisterTileTextSize}">
                                                <TextBlock FontSize="{DynamicResource RegisterTileTextSize}" FontFamily="{Binding Details,Converter={StaticResource ProductTextFont}}" Text="{Binding Details}" Visibility="{Binding Details,Converter={StaticResource StrToVis}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4"/>
                                                <TextBlock Text="{Binding StockText}" FontSize="{DynamicResource RegisterTileTextSize}" FontFamily="{Binding StockText,Converter={StaticResource ProductTextFont}}" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="{DynamicResource RegisterTileTextSize}" FontFamily="{Binding LocationText,Converter={StaticResource ProductTextFont}}" Text="{Binding LocationText}" Visibility="{Binding LocationText,Converter={StaticResource StrToVis}}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                            </StackPanel>
                                            <Grid Margin="3,6,3,0" FlowDirection="LeftToRight" Visibility="{Binding DataContext.IsPharmacy,RelativeSource={RelativeSource AncestorType=ItemsControl},Converter={StaticResource InverseBoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="−" Style="{StaticResource ProductQuantityButton}" IsEnabled="{Binding HasCartQuantity}"
                                                        ToolTip="{loc:T Pos_DecreaseQty}" AutomationProperties.Name="{loc:T Pos_DecreaseQty}"
                                                        AutomationProperties.HelpText="{Binding Product.Name}"
                                                        Command="{Binding DataContext.DecreaseFromResultsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Product}" />
                                                <TextBlock Grid.Column="1" Text="{Binding CartQuantity, StringFormat={}{0:0.###}}"
                                                       FontWeight="SemiBold" FontSize="{DynamicResource RegisterTileTextSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Button Grid.Column="2" Content="+" Style="{StaticResource ProductQuantityButton}"
                                                        ToolTip="{loc:T Pos_IncreaseQty}" AutomationProperties.Name="{loc:T Pos_IncreaseQty}"
                                                        AutomationProperties.HelpText="{Binding Product.Name}"
                                                        Command="{Binding DataContext.AddFromResultsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Product}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer></DockPanel>
                </Border>
                <Border DockPanel.Dock="Top" Margin="0" Padding="0" Visibility="{Binding ShowRegisterList,Converter={StaticResource BoolToVis}}">
                    <DataGrid x:Name="RegisterListTable" layout:TableLayout.Key="register-products-list" ItemsSource="{Binding ProductTiles}" IsReadOnly="True" MouseLeftButtonUp="ProductListClick" PreviewKeyDown="ProductListKey">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Pos_Product}" Binding="{Binding Product.Name}" Width="3*" ElementStyle="{StaticResource TableName}"/>
                        <DataGridTextColumn Header="{loc:T Pos_Details}" Binding="{Binding Details}" Width="2*" ElementStyle="{StaticResource TableName}"/>
                        <DataGridTextColumn Header="{loc:T Pos_SalePrice}" Binding="{Binding PriceText}" Width="1.3*" ElementStyle="{StaticResource TableMoney}"/>
                        <DataGridTextColumn Header="{loc:T Products_Stock}" Binding="{Binding StockText}" Width="1.4*" ElementStyle="{StaticResource TableName}"/>
                        <DataGridTextColumn x:Name="RegisterLocationsColumn" Header="{loc:T Pharmacy_Locations}" Binding="{Binding LocationText}" Width="1.5*" ElementStyle="{StaticResource TableName}"/>
                      </DataGrid.Columns>
                    </DataGrid>
                </Border>

</Grid></DockPanel></Border>
                <!-- cart -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="6,4,6,6">
                            <TextBlock Text="{loc:T Pos_Cart}" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="{Binding CartCustomerCaption}" Command="{Binding SelectCustomerCommand}" Style="{StaticResource GhostButton}" Margin="6,0" ToolTip="{loc:T Customer_SelectExisting}"/>
                            <Button Content="{loc:T Common_More}" Click="OpenCartActions" Style="{StaticResource GhostButton}" Margin="2">
                              <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{loc:T Trade_SaveDraft}" Command="{Binding SaveDraftCommand}"/>
                                <MenuItem Header="{loc:T Trade_ResumeDraft}" Command="{Binding ResumeDraftCommand}"/>
                                <MenuItem Header="{loc:T Trade_ProductSales}" Command="{Binding ViewCartProductHistoryCommand}"/>
                                <MenuItem Header="{loc:T Trade_ViewMargin}" Command="{Binding ViewMarginCommand}" Visibility="{Binding ShowMargin,Converter={StaticResource BoolToVis}}"/>
                              </ContextMenu></Button.ContextMenu>
                            </Button>
                        </WrapPanel>
                        <Grid Background="White" ClipToBounds="True">
                        <DataGrid layout:TableLayout.Key="register-cart-retail-kinds" x:Name="CartTable" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.VerticalScrollBarVisibility="Auto" RowDetailsVisibilityMode="Visible" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedCartLine}" VerticalAlignment="Stretch" Margin="0">
                        <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="DetailsVisibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFinancialService}" Value="True"><Setter Property="DetailsVisibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
                        <DataGrid.RowDetailsTemplate><DataTemplate>
                          <UniformGrid Columns="3" Margin="10" Visibility="{Binding IsFinancialService,Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="5"><TextBlock Text="{loc:T Service_Provider}"/><ComboBox ItemsSource="{Binding ServiceProviders}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedServiceProviderId}" AutomationProperties.Name="{loc:T Service_Provider}"/></StackPanel>
                            <StackPanel Margin="5" Visibility="{Binding IsPackageService,Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T Service_PackageName}"/><ComboBox ItemsSource="{Binding ServicePackages}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedServicePackageId}" AutomationProperties.Name="{loc:T Service_PackageName}"/></StackPanel>
                            <StackPanel Margin="5"><TextBlock Text="{loc:T Retail_Recipient}"/><TextBox Text="{Binding ServiceRecipient,UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="{loc:T Retail_Recipient}"/></StackPanel>
                            <StackPanel Margin="5" Visibility="{Binding IsPackageService,Converter={StaticResource InverseBoolToVis}}"><TextBlock Text="{loc:T Service_CustomerFee}"/><TextBox Text="{Binding ServiceFeeText,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:T Service_CustomerFee}"/></StackPanel>
                            <StackPanel Margin="5"><TextBlock Text="{loc:T Service_Reference}"/><TextBox Text="{Binding ServiceReference,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="{loc:T Service_Reference}"/></StackPanel>
                            <StackPanel Margin="5"><TextBlock Text="{loc:T Products_Status}"/><ComboBox ItemsSource="{Binding ServiceStates}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding ServiceStatus}" AutomationProperties.Name="{loc:T Products_Status}"/></StackPanel>
                            <CheckBox Margin="5" IsChecked="{Binding ServiceExternallyConfirmed}"><TextBlock Text="{loc:T Service_ExternalConfirmed}" TextWrapping="Wrap"/></CheckBox>
                          </UniformGrid>
                        </DataTemplate></DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:T Pos_Product}" Width="3.2*" MinWidth="82">
                              <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><Grid>
                                <TextBlock Text="{Binding Name}" FontFamily="{Binding Name,Converter={StaticResource ProductTextFont}}" Style="{StaticResource TableName}" Visibility="{Binding NeedsName,Converter={StaticResource InverseBoolToVis}}"/>
                                <TextBox Text="{Binding NameText,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NeedsName,Converter={StaticResource BoolToVis}}" Style="{StaticResource TableInput}" AutomationProperties.Name="{loc:T Products_Name}"/>
                              </Grid>
                              <StackPanel Visibility="{Binding IsDigital,Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                                <ComboBox ItemsSource="{Binding ServiceTypes}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedServiceType}" AutomationProperties.Name="{loc:T Service_Type}"/>

                              </StackPanel>
                              </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:T Pos_Qty}" Width=".8*" MinWidth="80">
                              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel><TextBox Tag="quantity" PreviewKeyDown="CartEditorKey" LostKeyboardFocus="CommitQuantity" Text="{Binding Quantity,UpdateSourceTrigger=Explicit,StringFormat={}{0:0.###}}" Style="{StaticResource TableInput}" ToolTip="{Binding EditError}" AutomationProperties.Name="{loc:T Pos_Qty}"/><TextBlock Text="{Binding EditError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Visibility="{Binding EditError,Converter={StaticResource StrToVis}}"/></StackPanel>
                              </DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:T Products_Unit}" Width="1.2*" MinWidth="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                              <TextBlock Text="{Binding UnitText}" Visibility="{Binding HasUnitChoices,Converter={StaticResource InverseBoolToVis}}" VerticalAlignment="Center"/>
                              <ComboBox Tag="unit" PreviewKeyDown="CartEditorKey" ItemsSource="{Binding SellingUnits}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SelectedSellingUnit,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasUnitChoices,Converter={StaticResource BoolToVis}}" ToolTip="{Binding EditError}"/>
                            </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:T Pos_CartPrice}" MinWidth="66" Width="1.65*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Tag="price" PreviewKeyDown="CartEditorKey" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                                                 FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}"
                                                 ToolTip="{loc:T Pos_InvalidPrice}"
                                                 AutomationProperties.Name="{loc:T Pos_SalePrice}" VerticalAlignment="Center" IsEnabled="{Binding CanEditPrice}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource TableInput}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInvalidPrice}" Value="True">
                                                            <Setter Property="Background" Value="#FFFFE4E6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="RetailKindColumn" Header="{loc:T Retail_Kind}" Width="1.3*" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                              <TextBlock Text="{Binding ProductKindName}" Visibility="{Binding CanChooseKind,Converter={StaticResource InverseBoolToVis}}"/>
                              <ComboBox ItemsSource="{Binding ProductKinds}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding ProductKind}" Visibility="{Binding CanChooseKind,Converter={StaticResource BoolToVis}}"/>
                            </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="PendingTaxColumn" Visibility="Collapsed" Header="{loc:T Products_Vat}" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding TaxText,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding NeedsTax,Converter={StaticResource BoolToVis}}" Style="{StaticResource TableInput}" AutomationProperties.Name="{loc:T Products_Vat}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:T Pos_LineTotal}" Binding="{Binding LineTotalText}" MinWidth="64" Width="1.55*" IsReadOnly="True"
                                                ElementStyle="{StaticResource TableMoney}" />
                            <DataGridTemplateColumn Width="48" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}" Padding="6,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>
                        <Button Visibility="Collapsed" Command="{Binding ToggleScanCommand}" Content="{Binding ScanButtonText}"
                                Tag="{Binding IsScanActive}" Style="{StaticResource TableScanButton}" Margin="0,12,0,8">
                            <Button.RenderTransform><TranslateTransform Y="{Binding ActualHeight, ElementName=CartTable}" /></Button.RenderTransform>
                        </Button>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid></ScrollViewer>
        </DockPanel>

        <!-- RIGHT: totals + payment -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{loc:T Pos_Total}" Style="{StaticResource Muted}" />
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding GrossTotalText}" Style="{StaticResource BigMoney}" />
                        </Viewbox>

                        <Grid Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource Muted}">
                                <Run Text="{loc:T Pos_ItemCount}" /><Run Text=": " /><Run Text="{Binding ItemCountText}" />
                            </TextBlock>
                        </Grid>

                        <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />

                        <TextBlock Text="{loc:T Pos_VatBreakdown}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding VatBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Style="{StaticResource FitAmount}" HorizontalAlignment="Left" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding RateText}" Foreground="{StaticResource MutedBrush}" />
                                        </Viewbox>
                                        <Viewbox Grid.Column="1" Style="{StaticResource FitAmount}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding NetText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" FlowDirection="LeftToRight" />
                                        </Viewbox>
                                        <Viewbox Grid.Column="2" Style="{StaticResource FitAmount}">
                                            <TextBlock Text="{Binding VatText}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" />
                                        </Viewbox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Margin="0,14" Background="{StaticResource BorderBrush}" />

                        <!-- cart discount -->
                        <TextBlock Text="{loc:T Pos_CartDiscount}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CartDiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="%" AutomationProperties.Name="{loc:T Pos_DiscountPercent}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding CartDiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="PKR" AutomationProperties.Name="{loc:T Pos_DiscountAmount}" Margin="0,0,6,0" />
                            <Button Grid.Column="2" Content="{loc:T Pos_Apply}" Command="{Binding ApplyCartDiscountCommand}"
                                    Style="{StaticResource GhostButton}" Padding="12,8" />
                        </Grid>
                        <TextBlock Text="{Binding CartDiscountText}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                                   Visibility="{Binding CartDiscountText, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- payment buttons at bottom -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10" Visibility="{Binding Status, Converter={StaticResource StrToVis}}" />
                    <Button Content="{loc:T Pos_Cash}" Command="{Binding OpenCashCommand}" Style="{StaticResource SuccessButton}" Margin="0,4" />
                    <Button Content="{loc:T Trade_Credit}" Command="{Binding OpenCreditCommand}" Style="{StaticResource PrimaryButton}" Margin="0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{loc:T Pos_Card}" Command="{Binding OpenCardCommand}" Style="{StaticResource InfoButton}" Margin="0,4,3,4" />
                        <Button Grid.Column="1" Content="{loc:T Pos_Clear}" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}" Margin="3,4,0,4" />
                    </Grid>
                </StackPanel>

            </Grid>
        </Border>

        <!-- PAYMENT OVERLAY -->
        <Grid x:Name="PaymentOverlay" Grid.ColumnSpan="2" Background="#660F172A" KeyboardNavigation.TabNavigation="Cycle"
              Visibility="{Binding IsPaymentOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="{DynamicResource PaymentDialogWidth}" Padding="24" Margin="18"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T Pos_Pay}" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" TabIndex="100" Content="{loc:T Common_Cancel}" Command="{Binding CancelPaymentCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                        <Button Grid.Column="1" TabIndex="101" Content="{loc:T Pos_Pay}" Command="{Binding CompletePaymentCommand}" Style="{StaticResource SuccessButton}" Margin="6,0,0,0" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                      <StackPanel>
                        <TextBlock Text="{loc:T Pos_Total}" Style="{StaticResource Muted}" />
                        <Viewbox Style="{StaticResource FitAmount}" HorizontalAlignment="Left" Margin="0,0,0,16">
                            <TextBlock Text="{Binding GrossTotalText}" Style="{StaticResource BigMoney}" />
                        </Viewbox>
                        <TextBlock Text="{loc:T Scanner_CardTerminal}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowCardInstructions, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T Trade_CreditHint}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:T Trade_PaidNow}" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="CreditAmountInput" Text="{Binding CreditPaidNow, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,4,0,0" />
                            <TextBlock Text="{loc:T Trade_DueDate}" Style="{StaticResource FormLabel}" Margin="0,8,0,4"/><DatePicker SelectedDate="{Binding CreditDueDate}"/>
                            <TextBlock Text="{loc:T Trade_InternalNote}" Style="{StaticResource FormLabel}" Margin="0,8,0,4"/><TextBox Text="{Binding CreditNote,UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                            <TextBlock x:Name="TenderedLabel" Text="{loc:T Pos_Tendered}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                            <TextBox x:Name="CashAmountInput" IsEnabled="{Binding IsCashCollection}" FlowDirection="LeftToRight" Text="{Binding Tendered, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource TextSize20}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=TenderedLabel}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CashChangeLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Viewbox Grid.Column="1" Style="{StaticResource FitAmount}">
                                    <TextBlock Text="{Binding ChangeText}" Style="{StaticResource Money}" FontSize="{DynamicResource TextSize22}" FlowDirection="LeftToRight" />
                                </Viewbox>
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,16,0,12" Background="{StaticResource BorderBrush}" />
                        <views:CustomerFieldsView DataContext="{Binding Customer}" />
                        <TextBlock Text="{Binding CreditBalanceSummary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}" />
                      </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

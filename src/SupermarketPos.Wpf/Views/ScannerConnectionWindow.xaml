<Window x:Class="SupermarketPos.Wpf.Views.ScannerConnectionWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        xmlns:scan="clr-namespace:SupermarketPos.Infrastructure.Scanning;assembly=SupermarketPos.Infrastructure"
        Title="{loc:T Scanner_Panel}" Style="{StaticResource FormDialogWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}" Margin="22">
        <StackPanel Width="720">
            <TextBlock Text="{Binding DeviceName}" FontSize="{DynamicResource TextSize19}" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="{Binding DeviceName, Converter={StaticResource StrToVis}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="0,2,0,12" TextWrapping="Wrap" />
            <TextBlock Text="{loc:T Scanner_Method}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
            <ComboBox SelectedValue="{Binding Method}" SelectedValuePath="Tag" Margin="0,0,0,8">
                <ComboBoxItem Tag="{x:Static scan:ScanTransport.Wifi}" Content="{loc:T Scanner_Wifi}" />
                <ComboBoxItem Tag="{x:Static scan:ScanTransport.Bluetooth}" Content="{loc:T Scanner_Bluetooth}" />
                <ComboBoxItem Tag="{x:Static scan:ScanTransport.Usb}" Content="{loc:T Scanner_Usb}" />
            </ComboBox>
            <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding Network}" DisplayMemberPath="Label"
                      AutomationProperties.Name="{loc:T Scanner_Network}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Instructions}" Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
                <Button Content="{loc:T Scanner_PairTitle}" Command="{Binding PairPhoneCommand}" Style="{StaticResource PrimaryButton}"
                        Visibility="{Binding IsUnpaired, Converter={StaticResource BoolToVis}}" Margin="0,0,6,5" />
                <Button Content="{loc:T Scanner_ReconnectAction}" Command="{Binding ReconnectCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,5" />
                <Button Content="{loc:T Scanner_DisconnectAction}" Command="{Binding DisconnectCommand}" Style="{StaticResource StopButton}" Margin="0,0,6,5" />
                <Button Content="{loc:T Scanner_Forget}" Command="{Binding ForgetPhoneCommand}" Style="{StaticResource DangerButton}"
                        Visibility="{Binding IsPaired, Converter={StaticResource BoolToVis}}" Margin="0,0,6,5" />
            </WrapPanel>
            <StackPanel Margin="0,8,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Qr}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="185" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Image Source="{Binding Qr}" Height="176" Width="176" RenderOptions.BitmapScalingMode="NearestNeighbor"
                           FlowDirection="LeftToRight" AutomationProperties.Name="{loc:T Scanner_PairQr}" />
                    <StackPanel Grid.Column="2">
                        <WrapPanel>
                            <Button Content="{loc:T Scanner_CopyLink}" Command="{Binding CopyPairLinkCommand}"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <CheckBox Content="{loc:T Scanner_ManualDetails}" IsChecked="{Binding ShowManual}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBox Text="{Binding ManualDetails, Mode=OneWay}" FlowDirection="LeftToRight" IsReadOnly="True" TextWrapping="Wrap"
                                 Visibility="{Binding ShowManual, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Viewbox>
</Window>

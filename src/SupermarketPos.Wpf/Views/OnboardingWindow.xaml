<Window x:Class="SupermarketPos.Wpf.Views.OnboardingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization" Title="{loc:T Setup_Title}"
 Width="1100" Height="820" MinWidth="640" MinHeight="480" ResizeMode="CanResize" Style="{StaticResource CaptionWindow}"
 WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
 Background="{StaticResource BgBrush}" FontSize="{DynamicResource TextSize14}"
 FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
 <Window.Resources>
  <Style x:Key="RegistrationChoice" TargetType="RadioButton">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Margin" Value="6"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Frame" CornerRadius="12" Padding="18" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,16,0">
         <Ellipse x:Name="Ring" Fill="White" Stroke="{StaticResource MutedBrush}" StrokeThickness="2"/>
         <Ellipse x:Name="Dot" Fill="{StaticResource AccentBrush}" Margin="5" Visibility="Collapsed"/>
        </Grid>
        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter TargetName="Frame" Property="Background" Value="#EFF6FF"/>
        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Viewbox Style="{StaticResource DialogFit}">
  <Border Style="{StaticResource Card}" Width="{DynamicResource SetupDialogWidth}">
   <StackPanel>
    <TextBlock x:Name="Heading" Style="{StaticResource H1}" TextWrapping="Wrap" Margin="6,0,6,8" />
    <TextBlock x:Name="Description" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="6,0,6,10" />
    <ContentControl x:Name="Page" MinHeight="280" />
    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="6,8" />
    <Button x:Name="RecordsButton" Content="{loc:T License_OpenRecords}" Click="OpenRecords" Visibility="Collapsed" Style="{StaticResource GhostButton}" Margin="6" />
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="BackButton" Content="{loc:T Setup_Back}" Click="Back" Style="{StaticResource GhostButton}" Margin="6" />
     <Button x:Name="NextButton" Grid.Column="1" Content="{loc:T Setup_Next}" Click="Next" Style="{StaticResource PrimaryButton}" Margin="6" />
    </Grid>
   </StackPanel>
  </Border>
 </Viewbox>
</Window>

<UserControl x:Class="SupermarketPos.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
             xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"
             Background="{StaticResource BgBrush}">
    <TabControl Margin="16"><TabItem Header="{loc:T Digital_PhysicalHistory}">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="340" />
            <ColumnDefinition Width="3.5*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: X/Z report -->
        <DockPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="{loc:T Reports_Title}" Style="{StaticResource H1}" DockPanel.Dock="Top" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="ReportDayLabel" Text="{loc:T Reports_Day}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                    <DatePicker SelectedDate="{Binding SelectedDay}" Margin="0,0,0,12"
                                AutomationProperties.LabeledBy="{Binding ElementName=ReportDayLabel}" />
                    <WrapPanel>
                        <Button Content="{loc:T Reports_XReport}" Command="{Binding GenerateXCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6" />
                        <Button Content="{loc:T Reports_ZReport}" Command="{Binding GenerateZCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding ReportTitle}" Style="{StaticResource H1}" FontSize="{DynamicResource TextSize20}" Margin="0,0,0,12" />

                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_SaleCount}" Style="{StaticResource Muted}" HorizontalAlignment="Left" /><TextBlock Text="{Binding SaleCountText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_Gross}" HorizontalAlignment="Left" /><TextBlock Text="{Binding GrossText}" HorizontalAlignment="Right" Style="{StaticResource Money}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_Net}" Style="{StaticResource Muted}" HorizontalAlignment="Left" /><TextBlock Text="{Binding NetText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_Vat}" Style="{StaticResource Muted}" HorizontalAlignment="Left" /><TextBlock Text="{Binding VatText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" /></Grid>

                    <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:T Pos_VatBreakdown}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding VatBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <TextBlock Text="{Binding RateText}" HorizontalAlignment="Left" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding NetText}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding VatText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                    <TextBlock Text="{loc:T Reports_PaymentSplit}" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_CashTotal}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CashText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                    <Grid Margin="0,2"><TextBlock Text="{loc:T Reports_CardTotal}" HorizontalAlignment="Left" /><TextBlock Text="{Binding CardText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                    <Grid Margin="0,2" Visibility="{Binding OtherText, Converter={StaticResource StrToVis}}">
                        <TextBlock Text="{loc:T Payment_Other}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding OtherText}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                    </Grid>

                    <Button Content="{loc:T Reports_ExportPdf}" Command="{Binding ExportReportCommand}" Style="{StaticResource GhostButton}" Margin="0,18,0,0" />
                    <Button Content="{loc:T Trade_PrintReport}" Command="{Binding PrintReportCommand}" Style="{StaticResource GhostButton}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- RIGHT: history -->
        <DockPanel Grid.Column="1">
            <Border Style="{StaticResource Card}" DockPanel.Dock="Top" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="{loc:T Reports_OpenReceipt}" Command="{Binding OpenReceiptCommand}"
                                Style="{StaticResource GhostButton}" />
                        <TextBlock Text="{loc:T Reports_History}" Style="{StaticResource H1}" FontSize="{DynamicResource TextSize18}" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="{loc:T History_RecordSale}" Command="{Binding RecordSaleCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,4" />
                        <Button Content="{loc:T Bulk_ImportSales}" Command="{Binding ImportSalesCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,4" />
                        <Button Content="{loc:T Bulk_Template}" Command="{Binding DownloadSaleTemplateCommand}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,4" ToolTip="{loc:T Bulk_SaleHelp}" />
                    </WrapPanel>
                    <TextBox x:Name="InvoiceSearchBox" Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" ToolTip="{loc:T Trade_InvoiceSearch}" AutomationProperties.Name="{loc:T Trade_InvoiceSearch}" Margin="0,0,0,6"/>
                    <UniformGrid Columns="4" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding InvoicePayments}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding InvoicePayment}" AutomationProperties.Name="{loc:T Reports_Payment}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding InvoiceStatuses}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding InvoiceStatus}" AutomationProperties.Name="{loc:T Products_Status}" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding InvoiceMinimum, UpdateSourceTrigger=PropertyChanged, Delay=120}" ToolTip="{loc:T Trade_MinimumAmount}" AutomationProperties.Name="{loc:T Trade_MinimumAmount}" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding InvoiceMaximum, UpdateSourceTrigger=PropertyChanged, Delay=120}" ToolTip="{loc:T Trade_MaximumAmount}" AutomationProperties.Name="{loc:T Trade_MaximumAmount}"/>
                    </UniformGrid>
                    <TextBlock Text="{loc:T Bulk_SaleHelp}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding HistoryMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HistoryMessage, Converter={StaticResource StrToVis}}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ReturnSummary}" TextWrapping="Wrap" Visibility="{Binding ReturnSummary, Converter={StaticResource StrToVis}}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding HistoryError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Visibility="{Binding HistoryError, Converter={StaticResource StrToVis}}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="HistoryFromLabel" Text="{loc:T Common_From}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding HistoryFrom}" AutomationProperties.LabeledBy="{Binding ElementName=HistoryFromLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock x:Name="HistoryToLabel" Text="{loc:T Common_To}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding HistoryTo}" AutomationProperties.LabeledBy="{Binding ElementName=HistoryToLabel}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{loc:T Reports_Generate}" Command="{Binding LoadHistoryCommand}"
                                Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" MinHeight="40" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid layout:PanelHeights.Key="sales-history">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DataGrid layout:TableLayout.Key="sales-receipts" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSale}" SelectionMode="Single" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Reports_ReceiptNo}" Binding="{Binding ReceiptNo}" Width="1.1*" MinWidth="72"
                                            ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T History_SourceReceipt}" Binding="{Binding SourceReceiptNo}" Width="*" MinWidth="64"
                                            ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding DateText}" Width="1.3*" MinWidth="80"
                                            ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Reports_Cashier}" Binding="{Binding Cashier}" Width="*" MinWidth="54"
                                            ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Reports_Payment}" Binding="{Binding PaymentText}" Width="0.8*" MinWidth="52"
                                            ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Customer_Name}" Binding="{Binding CustomerLabel}" Width="*" MinWidth="66"
                                            ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Trade_Returns}" Binding="{Binding ReturnedText}" Width=".8*" MinWidth="70" ElementStyle="{StaticResource TableMoney}"/>
                        <DataGridTextColumn Header="{loc:T Products_Status}" Binding="{Binding StatusText}" Width="*" MinWidth="80" ElementStyle="{StaticResource TableName}"/>
                        <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding TotalText}" Width="*" MinWidth="66"
                                            ElementStyle="{StaticResource TableMoney}" SortMemberPath="Sale.GrossTotal" />
                    </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="12" VerticalAlignment="Top" Style="{StaticResource HeightDivider}"/><StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <WrapPanel Margin="0,4" Visibility="{Binding SelectedSale.ReceiptNo,Converter={StaticResource StrToVis},FallbackValue=Collapsed}">
                         <Button Content="{loc:T Customer_Details}" Command="{Binding EditCustomerCommand}" Style="{StaticResource GhostButton}" Margin="3"/>
                         <Button Content="{loc:T Trade_RepeatSale}" Command="{Binding RepeatSelectedSaleCommand}" Style="{StaticResource GhostButton}" Margin="3"/>
                         <Button Content="{loc:T Trade_ReturnItems}" Command="{Binding ReturnItemsCommand}" Style="{StaticResource GhostButton}" Margin="3"
                                 Visibility="{Binding ShowMargin, Converter={StaticResource BoolToVis}}"/>
                         <Button Content="{loc:T Trade_ViewMargin}" Command="{Binding ViewMarginCommand}" Style="{StaticResource GhostButton}" Margin="3"
                                 Visibility="{Binding ShowMargin, Converter={StaticResource BoolToVis}}"/>
                         <Button Content="{loc:T Trade_InvoiceAudit}" Command="{Binding ViewInvoiceAuditCommand}" Style="{StaticResource GhostButton}" Margin="3"
                                 Visibility="{Binding ShowMargin, Converter={StaticResource BoolToVis}}"/>
                         <Button Content="{loc:T Invoice_Print}" Command="{Binding PrintInvoiceCommand}" Style="{StaticResource PrimaryButton}" Margin="3"/>
                         <Button Content="{loc:T Invoice_WhatsApp}" Command="{Binding WhatsAppInvoiceCommand}" Style="{StaticResource PrimaryButton}" Margin="3"/>
                         <Button Content="{loc:T Invoice_Download}" Command="{Binding DownloadInvoiceCommand}" Style="{StaticResource PrimaryButton}" Margin="3"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,4,0,5">
                            <TextBlock Text="{loc:T Dash_InvoiceItems}" Style="{StaticResource FormLabel}" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding SelectedSale.InvoiceMargin}" ToolTip="{loc:T Dash_Profit}"
                                       Visibility="{Binding ShowMargin, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                    <WrapPanel>
                        <Button Content="{loc:T Trade_PreviousPage}" Command="{Binding PreviousHistoryPageCommand}" Style="{StaticResource GhostButton}" Padding="7,4"
                                Visibility="{Binding HasPreviousHistoryPage, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{loc:T Common_Next}" Command="{Binding NextHistoryPageCommand}" Style="{StaticResource GhostButton}" Padding="7,4" Margin="5,0,0,0"
                                Visibility="{Binding HasNextHistoryPage, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel></StackPanel>
                    <views:SaleItemsView Grid.Row="2" layout:TableLayout.Key="sales-items" DataContext="{Binding SelectedSale}" />
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
    </TabItem><TabItem x:Name="DigitalHistoryTab" Header="{loc:T Service_History}" Visibility="Collapsed"><ContentControl x:Name="DigitalHistory"/></TabItem><TabItem x:Name="DigitalReportTab" Header="{loc:T Service_Reports}" Visibility="Collapsed"><ContentControl x:Name="DigitalReport"/></TabItem></TabControl>
</UserControl>

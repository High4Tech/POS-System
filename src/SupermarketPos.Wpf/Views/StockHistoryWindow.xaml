<Window Style="{StaticResource CaptionWindow}" x:Class="SupermarketPos.Wpf.Views.StockHistoryWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
        Width="675" Height="450" MinWidth="450" MinHeight="310" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Border Margin="16" Style="{StaticResource Card}">
        <DataGrid layout:TableLayout.Key="stock-movements" ItemsSource="{Binding}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding OccurredAt, StringFormat=g}" Width="1.4*" />
                <DataGridTextColumn Header="{loc:T Stock_Type}" Binding="{Binding Kind}" Width="1.5*" />
                <DataGridTextColumn Header="{loc:T Stock_Change}" Binding="{Binding QuantityChange, StringFormat=0.###}" Width="*" />
                <DataGridTextColumn Header="{loc:T Batch_Lot}" Binding="{Binding BatchLot}" Width="*" />
                <DataGridTextColumn Header="{loc:T Purchase_ReferenceShort}" Binding="{Binding Reference}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Border>
</Window>

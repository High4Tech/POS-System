<UserControl x:Class="SupermarketPos.Wpf.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
             xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"
             Background="{StaticResource BgBrush}">
    <Grid Margin="24">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{loc:T Products_Title}" Style="{StaticResource H1}" Margin="0,0,0,12"/>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
              <WrapPanel DockPanel.Dock="Right" Margin="10,0,0,0">
                <Button Content="{loc:T Products_New}" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Visibility="{Binding CanManageStock, Converter={StaticResource BoolToVis}}"/>
                <Button Content="{loc:T Pharmacy_Locations}" Command="{Binding ManageStockLocationsCommand}" Style="{StaticResource GhostButton}" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                <Button Content="{loc:T Common_More}" Style="{StaticResource GhostButton}" Click="OpenMore">
                  <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{loc:T Retail_Templates}" Command="{Binding BrowseRetailTemplateCommand}" Visibility="{Binding IsPharmacy,Converter={StaticResource InverseBoolToVis}}"/>
                    <MenuItem Header="{loc:T Retail_CategoryTemplate}" Command="{Binding LoadRetailCategoriesCommand}" Visibility="{Binding IsPharmacy,Converter={StaticResource InverseBoolToVis}}"/>
                    <MenuItem Header="{loc:T Bulk_ImportProducts}" Command="{Binding ImportProductsCommand}"/>
                    <MenuItem Header="{loc:T Bulk_Template}" Command="{Binding DownloadProductTemplateCommand}"/>
                    <MenuItem Header="{loc:T Category_Manage}" Command="{Binding EditCategoriesCommand}"/>
                    <MenuItem Header="{loc:T Products_ShelfLabels}" Command="{Binding PrintLabelsCommand}"/>
                    <MenuItem Header="{loc:T Pharmacy_VerifyPhysicalStock}" Command="{Binding VerifyMedicineStockCommand}" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="{loc:T Trade_Devices}" Command="{Binding ShowDevicesCommand}" Visibility="{Binding DeviceTrackingAvailable,Converter={StaticResource BoolToVis}}"/>
                  </ContextMenu></Button.ContextMenu>
                </Button>
              </WrapPanel>
              <Grid>
                <ContentControl Content="{Binding InventoryMedicineSearch}" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}"/>
                <TextBox Text="{Binding Filter,UpdateSourceTrigger=PropertyChanged,Delay=120}" ToolTip="{loc:T Bulk_Search}" AutomationProperties.Name="{loc:T Bulk_Search}" Visibility="{Binding IsPharmacy,Converter={StaticResource InverseBoolToVis}}"/>
              </Grid>
            </DockPanel>
            <ScrollViewer x:Name="InventoryFilters" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <StackPanel Width="180" Margin="0,0,8,3"><TextBlock Text="{loc:T Products_Category}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding FilterCategories}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding FilterCategoryId}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3"><TextBlock Text="{loc:T Products_Stock}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding StockStates}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding StockState}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T Pharmacy_SetupStatus}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding SetupStates}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding SetupState}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T Pharmacy_Locations}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding LocationFilters}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedLocationFilter}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3"><TextBlock Text="{loc:T Batch_Expiry}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding ExpiryStates}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding ExpiryState}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T Pharmacy_CompanyShort}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding ManufacturerFilters}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding ManufacturerFilter}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3" Visibility="{Binding IsPharmacy,Converter={StaticResource BoolToVis}}"><TextBlock Text="{loc:T Pharmacy_Form}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding FormFilters}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding FormFilter}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3"><TextBlock Text="{loc:T Batch_Lot}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding BatchFilters}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding BatchFilter}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Width="180" Margin="0,0,8,3"><TextBlock Text="{loc:T Products_Barcode}" Style="{StaticResource FormLabel}" FontSize="{DynamicResource TextSize13}"/><ComboBox ItemsSource="{Binding BarcodeStates}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding BarcodeState}" ToolTip="{Binding SelectedItem.Name,RelativeSource={RelativeSource Self}}"/></StackPanel>
                <Button Content="{loc:T Pharmacy_ClearFilters}" Command="{Binding ClearPharmacyFiltersCommand}" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
              </StackPanel>
            </ScrollViewer>
            <CheckBox DockPanel.Dock="Top" Content="{loc:T Products_LowStockOnly}" IsChecked="{Binding LowStockOnly}" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding FilterSummary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="{loc:T Bulk_Clear}" Command="{Binding ClearSelectionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,5"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,12,5"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                <Button Content="{loc:T Bulk_Edit}" Command="{Binding OpenBulkEditCommand}" Style="{StaticResource PrimaryButton}" Padding="14,10" Margin="0,0,6,5"
                        Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVis}}" />
                <Button Content="{loc:T Bulk_Delete}" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,5"
                        Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding ImportMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"
                           Visibility="{Binding ImportMessage, Converter={StaticResource StrToVis}}" />
                <TextBlock Text="{Binding ImportError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Visibility="{Binding ImportError, Converter={StaticResource StrToVis}}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"
                        Visibility="{Binding ProductError, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding ProductError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                <Button Content="{loc:T Scanner_ViewMatching}" Command="{Binding ViewMatchingProductCommand}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding MatchingProduct.Name, Converter={StaticResource StrToVis}, FallbackValue=Collapsed}"
                        Style="{StaticResource GhostButton}" />
            </StackPanel>
            <Grid>
            <Border Style="{StaticResource Card}" Padding="6">
                <DataGrid x:Name="InventoryTable" layout:TableLayout.Key="inventory-products" ItemsSource="{Binding VisibleProducts}" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsLowStock}" Value="True" />
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Background" Value="#FFFFF5F5" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="38" CanUserResize="False" CanUserSort="False" CanUserReorder="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding DataContext.VisibleSelectionState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleVisibleSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              AutomationProperties.Name="{loc:T Bulk_SelectAllVisible}" ToolTip="{loc:T Bulk_SelectAllVisible}"
                                              Width="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{Binding Name}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:T Products_Name}" Width="2.3*" MinWidth="106" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource CatalogThumbnail}" Visibility="{Binding DataContext.ShowProductImages,RelativeSource={RelativeSource AncestorType=DataGrid},Converter={StaticResource BoolToVis}}"
                                                        Width="{DynamicResource InventoryThumbnailSize}" Height="{DynamicResource InventoryThumbnailSize}"
                                                        Margin="0,0,9,0" VerticalAlignment="Center" FontSize="{DynamicResource TextSize13}"
                                                        Background="{Binding Product.Category, Converter={StaticResource CatColor}}"
                                                        Tag="{Binding Product.ImagePath, Converter={StaticResource PathToImage}}"
                                                        Content="{Binding Product.Name, Converter={StaticResource Initials}}" />
                                        <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Style="{StaticResource TableName}" TextWrapping="Wrap" TextTrimming="None" MinHeight="40"/><TextBlock Text="{Binding Details}" TextWrapping="Wrap" Visibility="{Binding Details,Converter={StaticResource StrToVis}}"/><TextBlock Text="{Binding Locations}" TextWrapping="Wrap" Visibility="{Binding Locations,Converter={StaticResource StrToVis}}"/><TextBlock Text="{Binding SetupDetails}" TextWrapping="Wrap" Visibility="{Binding DataContext.NeedsSetupOnly,RelativeSource={RelativeSource AncestorType=DataGrid},Converter={StaticResource BoolToVis}}"/></StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:T Products_Barcode}" Binding="{Binding Barcode}" Width="1.35*" MinWidth="65"
                                            IsReadOnly="True" ElementStyle="{StaticResource TableValue}" />
                        <DataGridTextColumn Header="{loc:T Products_Category}" Binding="{Binding CategoryName}" Width="1.15*" MinWidth="54"
                                            IsReadOnly="True" ElementStyle="{StaticResource TableName}" />
                        <DataGridTextColumn Header="{loc:T Products_TablePrice}" Binding="{Binding PriceText}" Width="1.3*" MinWidth="68" IsReadOnly="True"
                                            ElementStyle="{StaticResource TableMoney}" SortMemberPath="Product.UnitPrice" />
                        <DataGridTextColumn Header="{loc:T Products_Vat}" Binding="{Binding VatText}" Width="0.68*" MinWidth="38" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Unit}" Binding="{Binding UnitText}" Width="0.72*" MinWidth="64" ElementStyle="{StaticResource TableName}" IsReadOnly="True" />
                        <DataGridTextColumn Header="{loc:T Products_Stock}" Binding="{Binding StockText}" Width="1*" MinWidth="78" IsReadOnly="True"
                                            ElementStyle="{StaticResource TableMoney}" SortMemberPath="Product.StockQuantity" />
                        <DataGridTemplateColumn Header="{loc:T Products_Status}" Width="1.05*" MinWidth="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                <Setter Property="Background" Value="#2216A34A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Background" Value="#22EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource TableSecondaryTextSize}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" ToolTip="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Foreground" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="88" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button ToolTip="{loc:T Common_Edit}" AutomationProperties.Name="{loc:T Common_Edit}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="32" Padding="0,4" Margin="0,0,4,0">
                                            <Path Width="15" Height="15" Stretch="Uniform" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" Data="M 2,13 L 2.8,9.5 L 10.9,1.4 Q 11.5,0.8 12.2,1.4 L 13.6,2.8 Q 14.2,3.5 13.6,4.1 L 5.5,12.2 Z M 9.2,3.1 L 11.9,5.8" />
                                        </Button>
                                        <Button Content="✕" ToolTip="{loc:T Common_Delete}" AutomationProperties.Name="{loc:T Common_Delete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Width="32" Padding="0,4" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            </Grid>
        </DockPanel>

        <Grid IsVisibleChanged="EditorVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle" Background="#660F172A" Visibility="{Binding IsBulkEditorOpen, Converter={StaticResource BoolToVis}}">
            <Viewbox Style="{StaticResource DialogFit}">
                <Border Style="{StaticResource Card}" Width="{DynamicResource CompactDialogWidth}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="{loc:T Bulk_Edit}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding SelectionText}" Style="{StaticResource Muted}" Margin="0,3,0,6" />
                        <TextBlock Text="{loc:T Bulk_Optional}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="{loc:T Products_Price}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BulkPrice, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:T Products_Stock}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BulkStock, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:T Products_Vat}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BulkVatPercent, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:T Products_Category}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding BulkCategories}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding BulkCategoryId}" Margin="0,0,0,18" />
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="{loc:T Common_Cancel}" Command="{Binding CancelBulkEditCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <Button Content="{loc:T Bulk_Apply}" Command="{Binding ApplyBulkEditCommand}" Style="{StaticResource PrimaryButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <Grid IsVisibleChanged="EditorVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle" Background="#660F172A" Visibility="{Binding IsCategoryEditorOpen, Converter={StaticResource BoolToVis}}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SaveCategoryCommand.IsRunning}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Style="{StaticResource DialogFit}">
                <Border Style="{StaticResource Card}" Width="{DynamicResource CompactDialogWidth}" Padding="28">
                    <StackPanel>
                        <TextBlock Text="{loc:T Category_Manage}" Style="{StaticResource H1}" Margin="0,0,0,16" />
                        <TextBlock Text="{loc:T Category_Existing}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Content="{loc:T Category_New}" Command="{Binding NewCategoryCommand}"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <ComboBox ItemsSource="{Binding Editor.Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" />
                        </DockPanel>
                        <TextBlock Text="{loc:T Products_Name}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,14" />
                        <WrapPanel Margin="0,0,0,16">
                            <Border Width="42" Height="36" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" Background="{Binding CategoryColor, Converter={StaticResource CatColor}}" Margin="0,0,8,0" />
                            <Button Content="{loc:T Category_ChooseColor}" Click="ChooseCategoryColor" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding CategoryColor}" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding ShowProductImages,Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Category_Image}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,16" LastChildFill="True">
                            <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="8" Margin="0,0,10,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CategoryImagePreview}" Stretch="Uniform" />
                                </Border.Background>
                            </Border>
                            <WrapPanel VerticalAlignment="Center">
                                <Button Content="{loc:T Category_ChooseImage}" Command="{Binding BrowseCategoryImageCommand}"
                                        Style="{StaticResource GhostButton}" Margin="0,0,6,0" />
                                <Button Content="{loc:T Category_RemoveImage}" Command="{Binding RemoveCategoryImageCommand}"
                                        Style="{StaticResource DangerButton}" />
                            </WrapPanel>
                        </DockPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding CategoryError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Visibility="{Binding CategoryError, Converter={StaticResource StrToVis}}" />
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="{loc:T Common_Cancel}" Command="{Binding CloseCategoryEditorCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                            <Button Content="{loc:T Common_Save}" Command="{Binding SaveCategoryCommand}" Style="{StaticResource PrimaryButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <Grid IsVisibleChanged="EditorVisibilityChanged" KeyboardNavigation.TabNavigation="Cycle" Background="#660F172A" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Viewbox Style="{StaticResource DialogFit}">
                <Border Style="{StaticResource Card}" Width="{DynamicResource ProductDialogWidth}" Padding="24">
                    <views:ProductEditorView />
                </Border>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>

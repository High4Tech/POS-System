<UserControl x:Class="SupermarketPos.Wpf.Views.LowStockNotifications"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization">
    <UserControl.Resources>
        <DropShadowEffect x:Key="NotificationShadow" Color="#1D354B" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.21" />
        <Style x:Key="AlertCard" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="12" Effect="{StaticResource NotificationShadow}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFF8FAFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#FFF0F5FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ToggleButton IsChecked="{Binding ShowAlertCards, Mode=TwoWay}" HorizontalAlignment="Right"
                      AutomationProperties.Name="{loc:T Stock_ToggleAlerts}" Cursor="Hand" Margin="0,0,0,8">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Header" Background="{StaticResource SurfaceBrush}" CornerRadius="11"
                            Padding="10,7" Effect="{StaticResource NotificationShadow}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T Stock_AlertsHeading}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#FFEEF2F7" CornerRadius="8" Padding="6,2" Margin="7,0,0,0">
                                <TextBlock Text="{Binding Items.Count}" FontWeight="SemiBold" />
                            </Border>
                            <Path x:Name="Chevron" Data="M 1,1 L 5,5 L 9,1" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="8,0,0,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><RotateTransform Angle="180" /></Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="Background" Value="#FFF8FAFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Header" Property="Background" Value="#FFF0F5FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Border Width="350" CornerRadius="14" Background="#FFE7EEF7" BorderBrush="#FFCFD9E6" BorderThickness="1"
                Effect="{StaticResource NotificationShadow}" Padding="10,8,10,10"
                Visibility="{Binding ShowAlertCards, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <ScrollViewer MaxHeight="260" Padding="7,5,7,2" Margin="-5,0,-5,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource AlertCard}" CommandParameter="{Binding}"
                                        Command="{Binding DataContext.ShowRestockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{loc:T Products_Restock}"
                                        ToolTip="{Binding Name}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ContentControl Width="46" Height="46" Margin="0,0,11,0" Style="{StaticResource CatalogThumbnail}"
                                                        Visibility="{Binding DataContext.ShowProductImages,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolToVis}}"
                                                        Background="{Binding Category, Converter={StaticResource CatColor}}" FontSize="{DynamicResource TextSize16}"
                                                        Tag="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                                        Content="{Binding Name, Converter={StaticResource Initials}}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Foreground="{StaticResource StopBrush}" FontSize="{DynamicResource TextSize12}" Margin="0,3,0,0">
                                                <Run Text="{loc:T Stock_OnHand}" /><Run Text=" · " /><Run Text="{Binding StockQuantity, Mode=OneWay, StringFormat={}{0:0.###}}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Path Grid.Column="2" Data="M 1,1 L 5,5 L 1,9" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="10,0,2,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Content="{loc:T Stock_ViewAll}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,4,0,0"
                        Command="{Binding DataContext.ShowRestockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding HasMoreAlerts, Converter={StaticResource BoolToVis}}" Padding="11,6" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl x:Class="SupermarketPos.Wpf.Views.ProductEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:views="clr-namespace:SupermarketPos.Wpf.Views">
    <UserControl.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/><Setter Property="Background" Value="#FFFFE4E6"/><Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self},Path=(Validation.Errors)[0].ErrorContent}"/></Trigger></Style.Triggers></Style>
        <DataTemplate x:Key="NamedOption">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource TextSize15}" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock FontSize="{DynamicResource TextSize20}" Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                    <Setter Property="Text" Value="{loc:T Products_New}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Editor.IsNew}" Value="False">
                            <Setter Property="Text" Value="{loc:T Products_EditTitle}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{loc:T Scanner_EditPaused}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="{Binding IsScannerEntry, Converter={StaticResource BoolToVis}}" />
        <TextBlock Text="{Binding ProductError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,12" Visibility="{Binding ProductError, Converter={StaticResource StrToVis}}" />

        <StackPanel Visibility="{Binding Editor.IsPharmacy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:T Pharmacy_RequiredLegend}" Style="{StaticResource Muted}"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:T Pharmacy_MedicineInformation}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBlock Text="{loc:T Pharmacy_MedicineNameRequired}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <ContentControl Content="{Binding MedicineNameSearch}" Margin="0,0,0,7"/>
                        <TextBlock Text="{loc:T Products_Barcode}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.Barcode, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Products_Barcode}" Margin="0,0,0,7" x:Name="MedicineBarcodeField" FlowDirection="LeftToRight" MaxLength="64"/>
                        <TextBlock Text="{loc:T Products_Category}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <ComboBox SelectedValue="{Binding Editor.CategoryId}" ItemsSource="{Binding Editor.Categories}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="{loc:T Products_Category}" Margin="0,0,0,7"/>
                        <TextBlock Text="{loc:T Pharmacy_Generic}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.MedicineGeneric, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_Generic}" Margin="0,0,0,7" MaxLength="500"/>
                        <TextBlock Text="{loc:T Pharmacy_Strength}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.MedicineStrength, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_Strength}" Margin="0,0,0,7" MaxLength="500"/>
                        <TextBlock Text="{loc:T Pharmacy_Form}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.MedicineForm, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_Form}" Margin="0,0,0,7" MaxLength="500"/>
                        <TextBlock Text="{loc:T Pharmacy_Manufacturer}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.MedicineManufacturer, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_Manufacturer}" Margin="0,0,0,7" MaxLength="500"/>
                        <Button Content="{loc:T Scanner_ViewMatching}" Command="{Binding ViewMatchingProductCommand}" Style="{StaticResource GhostButton}" Visibility="{Binding MatchingProduct.Name, Converter={StaticResource StrToVis}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="{loc:T Pharmacy_SellingPricing}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBlock Text="{loc:T Pharmacy_SellAs}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <ComboBox SelectedValue="{Binding Editor.MedicineUnit}" ItemsSource="{Binding Editor.MedicineUnits}" SelectedValuePath="Code" DisplayMemberPath="Name" AutomationProperties.Name="{loc:T Pharmacy_SellAs}" Margin="0,0,0,7"/>
                        <TextBlock Text="{loc:T Pharmacy_SellingPrice}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.Price, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_SellingPrice}" Margin="0,0,0,7" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{loc:T Purchase_UnitCost}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.PurchaseCost, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Purchase_UnitCost}" Margin="0,0,0,7" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{loc:T Products_Vat}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.VatPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Products_Vat}" Margin="0,0,0,7" />
                        <StackPanel Visibility="{Binding Editor.ShowMedicinePackaging, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T Pharmacy_UnitsPerStrip}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                            <TextBox Text="{Binding Editor.UnitsPerStrip, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_UnitsPerStrip}" Margin="0,0,0,7" />
                            <TextBlock Text="{loc:T Pharmacy_OptionalStripsPerPack}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                            <TextBox Text="{Binding Editor.MedicinePackStrips, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_OptionalStripsPerPack}" Margin="0,0,0,7" />
                            <TextBlock Text="{loc:T Pharmacy_StripPrice}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                            <TextBox Text="{Binding Editor.StripPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Pharmacy_StripPrice}" Margin="0,0,0,7" />
                            <TextBlock Text="{loc:T Measure_PackPrice}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                            <TextBox Text="{Binding Editor.PackagePrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Measure_PackPrice}" Margin="0,0,0,7" />
                            <TextBlock Text="{loc:T Measure_PackBarcode}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                            <TextBox Text="{Binding Editor.PackageBarcode, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Measure_PackBarcode}" Margin="0,0,0,7" x:Name="MedicinePackBarcodeField" MaxLength="64" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{loc:T Pharmacy_StockLocation}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBlock Text="{Binding Editor.CurrentStockText}" TextWrapping="Wrap" Visibility="{Binding Editor.IsNew, Converter={StaticResource InverseBoolToVis}}"/>
                        <StackPanel Visibility="{Binding ShowPharmacyOpeningStock, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T Batch_Opening}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                            <TextBox Text="{Binding Editor.Stock, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Batch_Opening}" Margin="0,0,0,7" FlowDirection="LeftToRight"/>
                            <StackPanel Visibility="{Binding Editor.ChooseOpeningUnit, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T Pharmacy_OpeningStockUnit}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                                <ComboBox SelectedValue="{Binding Editor.OpeningStockUnit}" ItemsSource="{Binding Editor.SaleUnits}" SelectedValuePath="Code" DisplayMemberPath="Name" AutomationProperties.Name="{loc:T Pharmacy_OpeningStockUnit}" Margin="0,0,0,7"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{loc:T Pharmacy_DefaultLocation}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <ComboBox SelectedValue="{Binding Editor.DefaultLocationId}" ItemsSource="{Binding Editor.Locations}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="{loc:T Pharmacy_DefaultLocation}" Margin="0,0,0,7"/>
                        <TextBlock Text="{loc:T Supplier_Optional}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <ComboBox SelectedValue="{Binding Editor.SupplierId}" ItemsSource="{Binding Editor.Suppliers}" SelectedValuePath="Id" DisplayMemberPath="Name" AutomationProperties.Name="{loc:T Supplier_Optional}" Margin="0,0,0,7"/>
                        <TextBlock Text="{loc:T Measure_MinimumStock}" Style="{StaticResource FormLabel}" TextWrapping="Wrap" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding Editor.MinimumStock, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" AutomationProperties.Name="{loc:T Measure_MinimumStock}" Margin="0,0,0,7" />
                        <CheckBox Content="{loc:T Batch_Track}" IsChecked="{Binding Editor.TrackExpiry}" IsEnabled="{Binding Editor.HasExistingBatches, Converter={StaticResource InverseBoolToVis}}"/>
                        <StackPanel Visibility="{Binding ShowPharmacyOpeningBatch, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T Batch_Lot}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Editor.BatchLot, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" MaxLength="20"
                                AutomationProperties.Name="{loc:T Batch_Lot}" Margin="0,0,0,8" />
                                <TextBlock Text="{loc:T Batch_Expiry}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                                <views:BatchDatePicker SelectedDate="{Binding Editor.BatchExpiry}" SelectedDateFormat="Short"
                                    Style="{StaticResource {x:Type DatePicker}}" ToolTip="{loc:T Batch_DateHelp}"
                                        AutomationProperties.Name="{loc:T Batch_Expiry}" Margin="0,0,0,8" />
                                    </StackPanel>
                                    <CheckBox Content="{loc:T Scanner_ProductActive}" IsChecked="{Binding Editor.IsActive}"/>
                                    <CheckBox Content="{loc:T Pharmacy_RequiresPrescription}" IsChecked="{Binding Editor.RequiresPrescription}" Visibility="{Binding Editor.ShowDispensingOptions, Converter={StaticResource BoolToVis}}"/>
                                    <CheckBox Content="{loc:T Pharmacy_RequiresReference}" IsChecked="{Binding Editor.RequiresDispensingReference}" Visibility="{Binding Editor.ShowDispensingOptions, Converter={StaticResource BoolToVis}}"/>
                                    <WrapPanel Visibility="{Binding Editor.IsNew, Converter={StaticResource InverseBoolToVis}}">
                                        <Button Content="{loc:T Stock_History}" Command="{Binding ShowStockHistoryCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"/>
                                        <Button Content="{loc:T Batch_Details}" Command="{Binding ViewBatchesCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Visibility="{Binding Editor.TrackExpiry, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="{loc:T Pharmacy_VerifyPhysicalStock}" Command="{Binding VerifyMedicineStockCommand}" Style="{StaticResource GhostButton}" Margin="0,0,6,6"/>
                                    </WrapPanel>
                                    <DockPanel Visibility="{Binding Editor.CanRestockNormally, Converter={StaticResource BoolToVis}}">
                                        <Button DockPanel.Dock="Right" Content="{loc:T Products_Restock}" Command="{Binding RestockCommand}" Style="{StaticResource GhostButton}"/>
                                        <TextBox AutomationProperties.Name="{loc:T Stock_RestockQuantity}" Text="{Binding RestockAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
        <Grid Visibility="{Binding Editor.ShowProductImages, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:T Products_Barcode}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <DockPanel Margin="0,0,0,8">
                    <Button Visibility="Collapsed" DockPanel.Dock="Right" Command="{Binding ToggleCaptureCommand}" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="{loc:T Scanner_Capture}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.IsNew}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScannerEntry}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCaptureArmed}" Value="True">
                                        <Setter Property="Content" Value="{loc:T Scanner_Stop}" />
                                        <Setter Property="Background" Value="{StaticResource StopBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBox x:Name="BarcodeField" Text="{Binding Editor.Barcode, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" FlowDirection="LeftToRight" />
                </DockPanel>
                <TextBlock Text="{loc:T Scanner_WaitingBarcode}" Style="{StaticResource Muted}" Margin="0,0,0,8"
                           Visibility="{Binding IsCaptureArmed, Converter={StaticResource BoolToVis}}" />
                <Button Content="{loc:T Scanner_ViewMatching}" Command="{Binding ViewMatchingProductCommand}"
                        HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding MatchingProduct.Name, Converter={StaticResource StrToVis}, FallbackValue=Collapsed}"
                        Style="{StaticResource GhostButton}" />

                <TextBlock Text="{loc:T Products_Name}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Margin="0,0,0,12" Visibility="{Binding Editor.ShowProductImages,Converter={StaticResource BoolToVis}}"/>
                <WrapPanel Margin="0,0,0,12">
                    <CheckBox Content="{loc:T Scanner_ProductActive}" IsChecked="{Binding Editor.IsActive}" Margin="0,0,12,0" />
                    <CheckBox Content="{loc:T Batch_Track}" IsChecked="{Binding Editor.TrackExpiry}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Editor.HasExistingBatches}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </WrapPanel>
                <TextBlock Text="{loc:T Measure_Method}" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding Editor.SellingMethods}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Editor.SellingMethod}" Margin="0,4,0,10"/>
                <TextBlock Text="{loc:T Measure_PriceHint}" Visibility="{Binding Editor.ShowProductImages,Converter={StaticResource BoolToVis}}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:T Measure_MinimumStock}" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Editor.MinimumStock,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Margin="0,4,0,8"/>


                <StackPanel Visibility="{Binding DeviceTrackingAvailable,Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:T Tech_Brand}" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Editor.Brand,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,4,0,8"/>
                <TextBlock Text="{loc:T Tech_Model}" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Editor.Model,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,4,0,8"/>
                <TextBlock Text="{loc:T Tech_Sku}" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding Editor.Sku,UpdateSourceTrigger=PropertyChanged}" MaxLength="120" Margin="0,4,0,8"/>
                <CheckBox Content="{loc:T Trade_SerialTrack}" IsChecked="{Binding Editor.TrackSerial}" Margin="0,0,0,8" />
                <TextBlock Text="{loc:T Trade_WarrantyMonths}" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding Editor.WarrantyMonths, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" FlowDirection="LeftToRight" Margin="0,4,0,8" />
                <Button Content="{loc:T Trade_Devices}" Command="{Binding ShowProductDevicesCommand}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Margin="0,0,0,12" Visibility="{Binding Editor.IsNew, Converter={StaticResource InverseBoolToVis}}" />

                </StackPanel>
                <!-- product image -->
                <Grid Margin="0,0,0,14" Visibility="{Binding Editor.ShowProductImages,Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Width="58" Height="58" Margin="0,0,12,0" Style="{StaticResource CatalogThumbnail}"
                                    Background="{Binding Editor.CategoryId, Converter={StaticResource CatColor}}"
                                    Tag="{Binding Editor.ImagePath, Converter={StaticResource PathToImage}}"
                                    Content="{Binding Editor.Name, Converter={StaticResource Initials}}" />
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="{loc:T Products_ChooseImage}" Command="{Binding Editor.BrowseImageCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,4" />
                        <Button Content="✕" Command="{Binding Editor.ClearImageCommand}" Style="{StaticResource DangerButton}" Padding="11,6" />
                    </WrapPanel>
                </Grid>
                <StackPanel Visibility="{Binding Editor.TrackExpiry, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <TextBlock Text="{loc:T Batch_Lot}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Editor.BatchLot, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" MaxLength="20"
                             AutomationProperties.Name="{loc:T Batch_Lot}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:T Batch_Expiry}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                    <views:BatchDatePicker SelectedDate="{Binding Editor.BatchExpiry}" SelectedDateFormat="Short"
                                           Style="{StaticResource {x:Type DatePicker}}" ToolTip="{loc:T Batch_DateHelp}"
                                           AutomationProperties.Name="{loc:T Batch_Expiry}" Margin="0,0,0,8" />
                    <StackPanel Visibility="{Binding Editor.CanAssignBatch, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                        <TextBlock Text="{loc:T Batch_Assign}" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding Editor.BatchQuantity, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                                 AutomationProperties.Name="{loc:T Batch_Assign}" Margin="0,4,0,8" />
                    </StackPanel>
                    <Button Content="{loc:T Batch_Details}" Command="{Binding ViewBatchesCommand}" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Visibility="{Binding Editor.IsTrackedExisting, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />
                </StackPanel>

            </StackPanel>
            <StackPanel Grid.Column="2">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="PriceLabel" Text="{loc:T Products_Price}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <TextBlock x:Name="VatLabel" Grid.Column="2" Text="{loc:T Products_Vat}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <TextBox Grid.Row="1" Text="{Binding Editor.Price, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" FlowDirection="LeftToRight"
                             AutomationProperties.LabeledBy="{Binding ElementName=PriceLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Editor.VatPercent, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                             FlowDirection="LeftToRight" AutomationProperties.LabeledBy="{Binding ElementName=VatLabel}" />
                </Grid>

                <TextBlock Text="{loc:T Purchase_UnitCost}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Editor.PurchaseCost, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" Margin="0,0,0,12"
                         FlowDirection="LeftToRight" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="StockLabel" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                <Setter Property="Text" Value="{loc:T Products_Stock}" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Editor.TrackExpiry}" Value="True" />
                                            <Condition Binding="{Binding Editor.IsNew}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="{loc:T Batch_Opening}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Grid.Row="1" Text="{Binding Editor.Stock, UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"
                             AutomationProperties.LabeledBy="{Binding ElementName=StockLabel}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPurchaseEntry}" Value="True"><Setter Property="IsReadOnly" Value="True" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Editor.IsTrackedExisting}" Value="True"><Setter Property="IsReadOnly" Value="True" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="CategoryLabel" Grid.Column="2" Text="{loc:T Products_Category}" Style="{StaticResource FormLabel}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Editor.Categories}" SelectedValue="{Binding Editor.CategoryId}"
                              SelectedValuePath="Id" TextSearch.TextPath="Name" ItemTemplate="{StaticResource NamedOption}"
                              ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"
                              AutomationProperties.LabeledBy="{Binding ElementName=CategoryLabel}" />
                </Grid>

                <TextBlock Text="{loc:T Supplier_Optional}" Style="{StaticResource FormLabel}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Editor.Suppliers}" SelectedValue="{Binding Editor.SupplierId}"
                          SelectedValuePath="Id" TextSearch.TextPath="Name" ItemTemplate="{StaticResource NamedOption}"
                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" Margin="0,0,0,12" />
                <StackPanel Visibility="{Binding Editor.UsesPackaging,Converter={StaticResource BoolToVis}}">
                 <TextBlock Text="{loc:T Measure_PurchaseUnit}" Style="{StaticResource FormLabel}"/><ComboBox ItemsSource="{Binding Editor.PurchaseUnits}" DisplayMemberPath="Name" SelectedValuePath="Code" SelectedValue="{Binding Editor.PurchaseUnit}"/>
                 <TextBlock Text="{loc:T Measure_UnitsPerPack}" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding Editor.UnitsPerPackage,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"/>
                 <TextBlock Text="{loc:T Measure_PackBarcode}" Style="{StaticResource FormLabel}"/><TextBox x:Name="PackageBarcodeField" Text="{Binding Editor.PackageBarcode,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}" MaxLength="64" FlowDirection="LeftToRight"/>
                 <TextBlock Text="{loc:T Measure_PackCost}" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding Editor.PackageCost,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"/>
                 <TextBlock Text="{loc:T Measure_PackPrice}" Style="{StaticResource FormLabel}"/><TextBox Text="{Binding Editor.PackagePrice,UpdateSourceTrigger=PropertyChanged,ValidatesOnDataErrors=True}"/>
                </StackPanel>
                <TextBlock Text="{loc:T Stock_RestockQuantity}" Style="{StaticResource FormLabel}"
                           Visibility="{Binding Editor.CanRestockNormally, Converter={StaticResource BoolToVis}}" />
                <Grid Margin="0,4,0,16" Visibility="{Binding Editor.CanRestockNormally, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding RestockAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="{loc:T Products_Restock}" Command="{Binding RestockCommand}" Style="{StaticResource GhostButton}" />
                </Grid>

                <Button Content="{loc:T Stock_History}" Command="{Binding ShowStockHistoryCommand}"
                        Visibility="{Binding Editor.IsNew, Converter={StaticResource InverseBoolToVis}}"
                        HorizontalAlignment="Left" Style="{StaticResource GhostButton}" />

            </StackPanel>
        </Grid>
        <Button Content="{loc:T Trade_ProductSales}" Command="{Binding ProductSalesCommand}" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Left" Visibility="{Binding Editor.IsNew, Converter={StaticResource InverseBoolToVis}}"/>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding CancelEditCommand}" Margin="0,0,6,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Content" Value="{loc:T Common_Cancel}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScannerEntry}" Value="True">
                                <Setter Property="Content" Value="{loc:T Scanner_Return}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="1" Content="{loc:T Scanner_SaveProduct}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" />
        </Grid>
    </StackPanel>
</UserControl>


<UserControl x:Class="SupermarketPos.Wpf.Views.ShortcutReference"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Focusable="False" AutomationProperties.Name="{loc:T Nav_Shortcuts}">
    <UserControl.Resources>
        <Style x:Key="ReferenceTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="MinRowHeight" Value="28"/>
            <Setter Property="ColumnHeaderHeight" Value="NaN"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="TextBlock" BasedOn="{StaticResource TableValue}">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource FieldSubtle}"/>
            <Setter Property="Padding" Value="4,1"/>
        </Style>
        <DataTemplate x:Key="ActionCell">
            <StackPanel>
                <TextBlock Text="{Binding Action}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Availability}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                           Visibility="{Binding Availability, Converter={StaticResource StrToVis}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="HeaderClose" DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButton}"
                    Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Top" Click="Close"
                    AutomationProperties.Name="{loc:T Common_Close}" ToolTip="{loc:T Common_Close}"/>
            <StackPanel>
                <TextBlock Text="{loc:T Nav_Shortcuts}" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
        <Button DockPanel.Dock="Bottom" Content="{loc:T Common_Close}" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right" Padding="12,6" Margin="0,12,0,0" Click="Close"/>
        <ScrollViewer x:Name="ReferenceScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.Name="{loc:T Nav_Shortcuts}">
            <StackPanel>
                <TextBlock Text="{loc:T Shortcut_CurrentPage}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <TextBlock x:Name="CurrentEmpty" Text="{loc:T Shortcut_Empty}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <DataGrid x:Name="CurrentTable" Style="{StaticResource ReferenceTable}"
                          AutomationProperties.Name="{loc:T Shortcut_CurrentPage}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Shortcut_Key}" Binding="{Binding Shortcut}" ElementStyle="{StaticResource KeyCap}" Width="1*"/>
                        <DataGridTemplateColumn Header="{loc:T Shortcut_Action}" CellTemplate="{StaticResource ActionCell}" Width="2.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{loc:T Shortcut_AllOther}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,14,0,6"/>
                <TextBlock x:Name="OtherEmpty" Text="{loc:T Shortcut_NoOther}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                <DataGrid x:Name="OtherTable" Style="{StaticResource ReferenceTable}"
                          AutomationProperties.Name="{loc:T Shortcut_AllOther}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T Shortcut_Key}" Binding="{Binding Shortcut}" ElementStyle="{StaticResource KeyCap}" Width="1*"/>
                        <DataGridTemplateColumn Header="{loc:T Shortcut_Action}" CellTemplate="{StaticResource ActionCell}" Width="1.65*"/>
                        <DataGridTextColumn Header="{loc:T Shortcut_Page}" Binding="{Binding Page}" ElementStyle="{StaticResource TableValue}" Width="1.35*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

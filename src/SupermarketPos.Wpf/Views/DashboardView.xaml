<UserControl x:Class="SupermarketPos.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
             xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <DropShadowEffect x:Key="MetricShadow" Color="#183149" BlurRadius="15"
                          ShadowDepth="3" Direction="270" Opacity="0.15" />
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="6,0,6,12" />
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Effect" Value="{StaticResource MetricShadow}" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF102D40" />
            <Setter Property="FontSize" Value="{DynamicResource TextSize32}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24" SizeChanged="DashboardSizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel x:Name="QuickActions" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{loc:T Nav_Pos}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                            Command="{Binding DataContext.ShowPosCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="{loc:T Nav_Products}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                            Command="{Binding DataContext.ShowProductsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="{loc:T Nav_Reports}" Style="{StaticResource GhostButton}"
                            Command="{Binding DataContext.ShowReportsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </WrapPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="2,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{loc:T Dash_Earnings}" FontSize="{DynamicResource TextSize18}"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                            <TextBlock x:Name="FromDateLabel" Text="{loc:T Common_From}" Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" MinWidth="150"
                                        AutomationProperties.LabeledBy="{Binding ElementName=FromDateLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                            <TextBlock x:Name="ToDateLabel" Text="{loc:T Common_To}" Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" MinWidth="150"
                                        AutomationProperties.LabeledBy="{Binding ElementName=ToDateLabel}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="{loc:T Dash_ApplyRange}" Command="{Binding ApplyDateRangeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" />
                        <Button Content="{loc:T Dash_Today}" Command="{Binding TodayCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,4" />
                    </WrapPanel>
                </DockPanel>
                <TextBlock Text="{Binding SalesError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" HorizontalAlignment="Right"
                           Visibility="{Binding SalesError, Converter={StaticResource StrToVis}}" Margin="0,4,0,0" />
            </StackPanel>
            <UniformGrid x:Name="EarningsCards" Grid.Row="2" Columns="4" Margin="-6,0,-6,12">
                <Border Style="{StaticResource MetricCard}" Background="{StaticResource BrandGradient}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Dash_Revenue}" Style="{StaticResource MetricLabel}" Foreground="White" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding RevenueText}" Style="{StaticResource MetricValue}" Foreground="White" />
                        </Viewbox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Dash_Sales}" Style="{StaticResource MetricLabel}" />
                        <TextBlock Text="{Binding SaleCountText}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Dash_Vat}" Style="{StaticResource MetricLabel}" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding VatText}" Style="{StaticResource MetricValue}" />
                        </Viewbox>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Background="#FF132B3C" Visibility="{Binding ShowProfit, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:T Dash_GrossProfit}" Style="{StaticResource MetricLabel}" Foreground="White" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ProfitText}" Style="{StaticResource MetricValue}" Foreground="White" />
                        </Viewbox>
                        <TextBlock Text="{Binding ProfitNote}" Foreground="White" TextWrapping="Wrap"
                                   FontSize="{DynamicResource TextSize12}" Margin="0,4,0,0"
                                   Visibility="{Binding ProfitNote, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- section: catalog -->
            <StackPanel Grid.Row="3">
                <TextBlock Text="{loc:T Dash_Catalog}" FontSize="{DynamicResource TextSize18}" FontWeight="Bold" Margin="2,0,0,12" />
                <UniformGrid x:Name="CatalogCards" Columns="3" Margin="-6,0,-6,0">
                    <Border Style="{StaticResource MetricCard}" Background="{StaticResource BrandGradient}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Dash_Products}" Style="{StaticResource MetricLabel}" Foreground="White" />
                            <TextBlock Text="{Binding ProductsText}" Style="{StaticResource MetricValue}" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Background="#FFDDECE7">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Dash_Categories}" Style="{StaticResource MetricLabel}" Foreground="#FF284C43" />
                            <TextBlock Text="{Binding CategoriesText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Background="#FFF2E2E4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:T Dash_LowStock}" Style="{StaticResource MetricLabel}" Foreground="#FF684049" />
                            <TextBlock Text="{Binding LowStockText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,24,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{loc:T Dash_PreviewInvoice}" Command="{Binding PreviewInvoiceCommand}"
                                Style="{StaticResource PrimaryButton}" />
                        <Button DockPanel.Dock="Right" Content="{loc:T Customer_Details}" Command="{Binding EditCustomerCommand}"
                                Visibility="{Binding SelectedSale.ReceiptNo, Converter={StaticResource StrToVis}, FallbackValue=Collapsed}"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:T Reports_History}" Style="{StaticResource H1}" FontSize="{DynamicResource TextSize20}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <DataGrid layout:TableLayout.Key="dashboard-receipts" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedSale}" IsReadOnly="True"
                                  SelectionMode="Single" Height="258">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T Reports_ReceiptNo}" Binding="{Binding ReceiptNo}" Width="*" ElementStyle="{StaticResource TableValue}" />
                                <DataGridTextColumn Header="{loc:T Reports_Date}" Binding="{Binding DateText}" Width="1.2*" ElementStyle="{StaticResource TableValue}" />
                                <DataGridTextColumn Header="{loc:T Reports_Payment}" Binding="{Binding PaymentText}" Width="*" ElementStyle="{StaticResource TableName}" />
                                <DataGridTextColumn Header="{loc:T Customer_Name}" Binding="{Binding CustomerLabel}" Width="*" MinWidth="66"
                                                    ElementStyle="{StaticResource TableName}" />
                                <DataGridTextColumn Header="{loc:T Pos_Total}" Binding="{Binding TotalText}" Width="*" ElementStyle="{StaticResource TableMoney}" SortMemberPath="Sale.GrossTotal" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{loc:T Dash_NoSales}" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,24,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding ShowEmptyHistory, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsHistoryEmpty, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="{loc:T Dash_InvoiceItems}" FontSize="{DynamicResource TextSize16}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <views:SaleItemsView layout:TableLayout.Key="dashboard-items" DataContext="{Binding SelectedSale}" Height="258" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

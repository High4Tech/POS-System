<Window x:Class="SupermarketPos.Wpf.Views.RecordSaleWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
        xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"
        Title="{loc:T History_RecordSale}" Style="{StaticResource FormDialogWindow}"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}">
    <Viewbox Style="{StaticResource DialogFit}" Margin="18">
    <DockPanel x:Name="Form" Width="1030">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{loc:T Common_Cancel}" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="{loc:T Common_Save}" Style="{StaticResource PrimaryButton}" Click="Save" />
            </WrapPanel>
        </StackPanel>
            <StackPanel>
                <StackPanel x:Name="SaleEntry">
                    <TextBlock Text="{loc:T History_RecordingHelp}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel MinWidth="170" Margin="0,0,10,6">
                            <TextBlock Text="{loc:T History_SourceReceipt}" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="ReceiptReference" MaxLength="80" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel MinWidth="150" Margin="0,0,10,6">
                            <TextBlock Text="{loc:T Reports_Date}" Style="{StaticResource FormLabel}" />
                            <DatePicker x:Name="SoldDate" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel MinWidth="84" Margin="0,0,10,6">
                            <TextBlock Text="{loc:T History_Time}" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="SoldTime" MaxLength="8" FlowDirection="LeftToRight" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel MinWidth="140" Margin="0,0,10,6">
                            <TextBlock Text="{loc:T Reports_Payment}" Style="{StaticResource FormLabel}" />
                            <ComboBox x:Name="PaymentMethod" SelectedValuePath="Code" DisplayMemberPath="Name" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel MinWidth="130" Margin="0,0,10,6">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=PaymentMethod}" Value="CASH">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{loc:T History_OptionalTender}" Style="{StaticResource FormLabel}" />
                            <TextBox x:Name="CashTendered" FlowDirection="LeftToRight" Margin="0,3,0,0" />
                        </StackPanel>
                    </WrapPanel>
                    <DataGrid layout:TableLayout.Key="manual-sale-lines" x:Name="ItemsTable" CanUserAddRows="True" CanUserDeleteRows="True" Height="235" Margin="0,0,0,14">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T Products_Barcode}" Binding="{Binding Barcode}" Width="1.2*" ElementStyle="{StaticResource TableValue}" />
                            <DataGridTextColumn Header="{loc:T Pos_Product}" Binding="{Binding Name}" Width="1.8*" MinWidth="90" ElementStyle="{StaticResource TableName}" />
                            <DataGridTextColumn Header="{loc:T Pos_Qty}" Binding="{Binding Quantity}" Width="0.55*" />
                            <DataGridTextColumn Header="{loc:T Pos_SalePrice}" Binding="{Binding Price}" Width="*" />
                            <DataGridTextColumn Header="{loc:T Products_Vat}" Binding="{Binding Vat}" Width="0.65*" />
                            <DataGridTextColumn Header="{loc:T Purchase_UnitCost}" Binding="{Binding UnitCost}" Width="*" />
                            <DataGridTextColumn Header="{loc:T History_ChargedTotal}" Binding="{Binding ChargedGross}" Width="1.2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                <views:CustomerFieldsView x:Name="CustomerFields" />
            </StackPanel>
    </DockPanel>
    </Viewbox>
</Window>

<UserControl x:Class="SupermarketPos.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Border Style="{StaticResource Card}" Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32">
            <StackPanel>
                <Image Source="{Binding DataContext.StoreProfile.LogoPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PathToImage}}"
                       Visibility="{Binding DataContext.StoreProfile.LogoPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource HasImageToVis}}"
                       Width="120" Height="72" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="{Binding DataContext.StoreProfile.Name, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="{DynamicResource TextSize22}" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="{loc:T Login_Title}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                <TextBlock Text="{loc:T Login_Username}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                <TextBlock Text="{loc:T Login_Password}" Style="{StaticResource FormLabel}" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding LoginCommand}" />
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,4,0,8" Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />

                <Button Content="{loc:T Login_Button}" Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" />
            <Button Command="{Binding RecoverOwnerCommand}" Style="{StaticResource GhostButton}" Margin="0,8,0,0" HorizontalContentAlignment="Stretch">
                <TextBlock Text="{loc:T Recovery_Open}" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>

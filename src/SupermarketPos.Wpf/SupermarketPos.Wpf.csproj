<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SupermarketPos.Wpf</RootNamespace>
    <AssemblyName>SupermarketPos</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Tech Store POS</Product>
    <AssemblyTitle>Tech Store POS</AssemblyTitle>
    <SatelliteResourceLanguages>ur</SatelliteResourceLanguages>
    <StartupObject>SupermarketPos.Wpf.Program</StartupObject>
    <CommercialBuild Condition="'$(CommercialBuild)' == ''">false</CommercialBuild>
    <RetailTestEdition Condition="'$(RetailTestEdition)' == ''">false</RetailTestEdition>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RetailTestEdition)' == 'true'">
    <Product>High4Tech POS Test</Product>
    <AssemblyTitle>High4Tech POS Test</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <AssemblyMetadata Include="CommercialBuild" Value="$(CommercialBuild)" />
    <AssemblyMetadata Include="RetailTestEdition" Value="$(RetailTestEdition)" />
    <AssemblyMetadata Include="BuildConfiguration" Value="$(Configuration)" />
    <AssemblyMetadata Include="BuildTimestampUtc" Value="$(BuildTimestampUtc)" />
    <AssemblyMetadata Include="BuildSourceFingerprint" Value="$(BuildSourceFingerprint)" />
    <AssemblyMetadata Include="PublisherApi" Value="$(PublisherApi)" />
    <AssemblyMetadata Include="PublisherPublicKey" Value="$(PublisherPublicKey)" />
    <AssemblyMetadata Include="ReleaseChannel" Value="$(ReleaseChannel)" />
    <AssemblyMetadata Include="PublisherSupport" Value="$(PublisherSupport)" />
    <AssemblyMetadata Include="ReleasePublishedAt" Value="$(ReleasePublishedAt)" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="..\..\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\fonts\OFL.txt" Link="Licenses\Noto-Nastaliq-Urdu-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(PosDataDirectory)' != ''">
    <RuntimeHostConfigurationOption Include="SupermarketPos.DataDirectory" Value="$(PosDataDirectory)" />
  </ItemGroup>
  <Target Name="ValidateCommercialConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(CommercialBuild)' == 'true'">
    <Error Condition="'$(RetailTestEdition)' == 'true'" Text="The isolated retail test edition cannot be a commercial licensing build." />
    <Error Condition="'$(PublisherApi)' == '' Or !$(PublisherApi.StartsWith('https://'))" Text="Commercial builds require an HTTPS PublisherApi." />
    <Error Condition="'$(PublisherPublicKey)' == '' Or '$(ReleasePublishedAt)' == ''" Text="Commercial builds require the public verification key and immutable release publication date." />
    <Error Condition="'$(ReleaseChannel)' != 'stable' And '$(ReleaseChannel)' != 'testing'" Text="Choose stable or an explicitly authorized testing channel for a commercial build." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\SupermarketPos.Application\SupermarketPos.Application.csproj" />
    <ProjectReference Include="..\SupermarketPos.Domain\SupermarketPos.Domain.csproj" />
    <ProjectReference Include="..\SupermarketPos.Infrastructure\SupermarketPos.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.*" />
  </ItemGroup>

</Project>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
                    xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common">
    <!-- PLUS POINT field proportions and neutrals, with the POS accent for interaction states. -->
    <SolidColorBrush x:Key="FieldBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="FieldBorderHover" Color="#94A3B8" />
    <SolidColorBrush x:Key="FieldText" Color="#0B2538" />
    <SolidColorBrush x:Key="FieldMuted" Color="#64748B" />
    <SolidColorBrush x:Key="FieldSubtle" Color="#F8FAFC" />
    <SolidColorBrush x:Key="FieldHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="FieldSelected" Color="#EBF3FF" />
    <SolidColorBrush x:Key="FieldError" Color="#DC2626" />
    <SolidColorBrush x:Key="TableSeparator" Color="#E2E8F0" />
    <CornerRadius x:Key="FieldRadius">8</CornerRadius>
    <DropShadowEffect x:Key="MenuShadow" Color="#0B2538" Opacity="0.17" BlurRadius="16" ShadowDepth="4" />
    <Style x:Key="FieldBase" TargetType="Control">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize15}" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="BorderBrush" Value="{StaticResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource FieldSubtle}" />
                <Setter Property="Foreground" Value="{StaticResource FieldMuted}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource FieldRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <TextBlock x:Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource FieldMuted}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="Outline" CornerRadius="{StaticResource FieldRadius}" BorderThickness="2"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource FieldSubtle}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FieldBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource FieldError}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TableInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{DynamicResource TableTextSize}" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <Style TargetType="PasswordBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource FieldRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Outline" CornerRadius="{StaticResource FieldRadius}" BorderThickness="2"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FieldBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource FieldError}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize15}" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Option" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Path x:Name="Check" DockPanel.Dock="Right" Width="14" Height="12" Margin="8,0,0,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Stretch="Uniform" Data="M 1,5 L 5,9 L 12,2" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Option" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Option" Property="Background" Value="{StaticResource FieldSelected}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Option" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource FieldBase}">
        <Setter Property="layout:SearchDropDown.Enabled" Value="True" />
        <Setter Property="MaxDropDownHeight" Value="306" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource FieldRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="12,6,10,6" IsHitTestVisible="False" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="Selection" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                            <Path Grid.Column="1" Data="M 1,2 L 6,7 L 11,2" Stroke="{StaticResource FieldMuted}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource {x:Type TextBox}}"
                                 Visibility="Collapsed" Margin="1,1,37,1" BorderThickness="0" MinHeight="0"
                                 Background="Transparent" IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <Border x:Name="Outline" CornerRadius="{StaticResource FieldRadius}" BorderThickness="2"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Border Background="White" BorderBrush="{StaticResource TableSeparator}" BorderThickness="1"
                                    CornerRadius="{StaticResource FieldRadius}" Padding="5" Margin="0,0,8,10"
                                    MinWidth="{TemplateBinding ActualWidth}" Effect="{StaticResource MenuShadow}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FieldBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource FieldError}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="20" Height="20">
                            <Border x:Name="Box" BorderThickness="1" BorderBrush="{StaticResource FieldBorderHover}"
                                    Background="White" CornerRadius="5" Margin="1" />
                            <Border x:Name="Outline" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" />
                            <Path x:Name="Check" Visibility="Collapsed" Stroke="White" StrokeThickness="1.8"
                                  Data="M 1,5 L 4,8 L 10,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="Mixed" Visibility="Collapsed" Stroke="White" StrokeThickness="1.8"
                                  Data="M 1,4 L 9,4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mixed" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Label" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarAction" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" CornerRadius="6"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonFrame" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarDay" TargetType="CalendarDayButton">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="Day" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="6" Margin="1">
                        <Grid>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource TextSize14}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse x:Name="TodayDot" Visibility="Collapsed" Width="4" Height="4" Margin="0,0,0,2"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource FieldMuted}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Day" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="TodayDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Day" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="TodayDot" Property="Fill" Value="White" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Day" Property="BorderBrush" Value="{StaticResource FieldBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Day" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Day" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarPeriod" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="Period" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="6" Margin="2">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{DynamicResource TextSize14}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource FieldMuted}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Period" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Period" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Period" Property="BorderBrush" Value="{StaticResource FieldBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Period" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarPanel" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" Foreground="{StaticResource FieldMuted}" FontSize="{DynamicResource TextSize12}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border x:Name="PART_Root" Background="White" BorderBrush="{StaticResource TableSeparator}"
                            BorderThickness="1" CornerRadius="10" Padding="10" Width="282">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button x:Name="PART_PreviousButton" DockPanel.Dock="Left" Style="{StaticResource CalendarAction}"
                                        AutomationProperties.Name="{loc:T Control_PreviousMonth}">
                                    <Path Data="M 7,1 L 2,6 L 7,11" Stroke="{StaticResource FieldText}" StrokeThickness="1.6" />
                                </Button>
                                <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Style="{StaticResource CalendarAction}"
                                        AutomationProperties.Name="{loc:T Control_NextMonth}">
                                    <Path Data="M 2,1 L 7,6 L 2,11" Stroke="{StaticResource FieldText}" StrokeThickness="1.6" />
                                </Button>
                                <Button x:Name="PART_HeaderButton" Style="{StaticResource CalendarAction}" />
                            </DockPanel>
                            <Grid x:Name="PART_MonthView" Grid.Row="1" Height="232" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                            </Grid>
                            <Grid x:Name="PART_YearView" Grid.Row="1" Height="232" Margin="0,4,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                            </Grid>
                            <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Background="#66FFFFFF"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosCalendar" TargetType="Calendar">
        <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarPanel}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDay}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarPeriod}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root">
                        <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DateFieldText" TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        <ContentControl x:Name="PART_Watermark" Foreground="{StaticResource FieldMuted}"
                                        Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker" BasedOn="{StaticResource FieldBase}">
        <Setter Property="CalendarStyle" Value="{StaticResource PosCalendar}" />
        <Setter Property="FirstDayOfWeek" Value="Monday" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{StaticResource FieldRadius}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <DockPanel Margin="1">
                            <Button x:Name="PART_Button" DockPanel.Dock="Right" Width="36" Margin="0,3,3,3" IsTabStop="False"
                                    Style="{StaticResource CalendarAction}" AutomationProperties.Name="{loc:T Control_OpenCalendar}">
                                <Viewbox Width="17" Height="17">
                                    <Path Stroke="{StaticResource FieldMuted}" StrokeThickness="1.5"
                                          Data="M 2,4 L 16,4 L 16,16 L 2,16 Z M 5,2 L 5,6 M 13,2 L 13,6 M 2,8 L 16,8" />
                                </Viewbox>
                            </Button>
                            <DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource DateFieldText}"
                                               Margin="10,0,0,0" Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                        <Border x:Name="Outline" CornerRadius="{StaticResource FieldRadius}" BorderThickness="2"
                                BorderBrush="Transparent" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                               AllowsTransparency="True" StaysOpen="False" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FieldBorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource FieldError}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FormLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#314354" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tab" Property="Background" Value="{StaticResource FieldSelected}" />
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource FieldBorder}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Tab" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="BorderBrush" Value="{StaticResource TableSeparator}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableSeparator}" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="MinColumnWidth" Value="36" />
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource TableRowHeight}" />
        <Setter Property="RowHeight" Value="{DynamicResource TableRowHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource TableTextSize}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="TableValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TableTextSize}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="TableName" TargetType="TextBlock" BasedOn="{StaticResource TableValue}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxHeight" Value="{DynamicResource TableLabelHeight}" />
    </Style>

    <Style x:Key="TableMoney" TargetType="TextBlock" BasedOn="{StaticResource TableValue}">
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TableSecondaryTextSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldSubtle}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldSelected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ColumnGripper" TargetType="Thumb">
        <Setter Property="Width" Value="6" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FieldSelected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource FieldSubtle}" />
        <Setter Property="Foreground" Value="#314354" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource TableHeadingTextSize}" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="{loc:T Table_FitColumns}" Command="{x:Static layout:TableLayout.FitColumnsCommand}"
                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding}" Foreground="#314354" FontSize="{DynamicResource TableHeadingTextSize}" FontWeight="SemiBold" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border x:Name="Header" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource TableSeparator}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Path x:Name="SortMark" DockPanel.Dock="Right" Visibility="Collapsed" Width="9" Height="6"
                                      Margin="4,0,0,0" VerticalAlignment="Center" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Thumb x:Name="LeadingResizeGrip" Style="{StaticResource ColumnGripper}" HorizontalAlignment="Left"
                               layout:TableLayout.ResizeGrip="Leading" />
                        <Thumb x:Name="TrailingResizeGrip" Style="{StaticResource ColumnGripper}" HorizontalAlignment="Right"
                               BorderBrush="{StaticResource TableSeparator}" BorderThickness="0,0,1,0"
                               layout:TableLayout.ResizeGrip="Trailing" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Column.CanUserResize, RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="False">
                            <Setter TargetName="LeadingResizeGrip" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TrailingResizeGrip" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="Background" Value="{StaticResource FieldHover}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortMark" Property="Data" Value="M 1,5 L 5,1 L 9,5" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortMark" Property="Data" Value="M 1,1 L 5,5 L 9,1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource FieldText}" />
        <Setter Property="FontSize" Value="{DynamicResource TableTextSize}" />
        <Setter Property="Padding" Value="9,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Cell" BorderBrush="Transparent" BorderThickness="1" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" ClipToBounds="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Cell" Property="Background" Value="{StaticResource FieldSelected}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

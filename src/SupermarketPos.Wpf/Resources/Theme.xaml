<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:layout="clr-namespace:SupermarketPos.Wpf.Common"
                    xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <layout:ProductTextFontConverter x:Key="ProductTextFont"/>
    <sys:Double x:Key="TextSize12">12</sys:Double>
    <sys:Double x:Key="TextSize13">13</sys:Double>
    <sys:Double x:Key="TextSize14">14</sys:Double>
    <sys:Double x:Key="TextSize15">15</sys:Double>
    <sys:Double x:Key="TextSize16">16</sys:Double>
    <sys:Double x:Key="TextSize17">17</sys:Double>
    <sys:Double x:Key="TextSize18">18</sys:Double>
    <sys:Double x:Key="TextSize19">19</sys:Double>
    <sys:Double x:Key="TextSize20">20</sys:Double>
    <sys:Double x:Key="TextSize21">21</sys:Double>
    <sys:Double x:Key="TextSize22">22</sys:Double>
    <sys:Double x:Key="TextSize26">26</sys:Double>
    <sys:Double x:Key="TextSize28">28</sys:Double>
    <sys:Double x:Key="TextSize32">32</sys:Double>
    <sys:Double x:Key="TextSize44">44</sys:Double>
    <sys:Double x:Key="TableTextSize">17</sys:Double>
    <sys:Double x:Key="TableHeadingTextSize">16</sys:Double>
    <sys:Double x:Key="TableSecondaryTextSize">15</sys:Double>
    <sys:Double x:Key="TableRowHeight">52</sys:Double>
    <sys:Double x:Key="RegisterCartMinimumHeight">160</sys:Double>
    <sys:Double x:Key="TableLabelHeight">46</sys:Double>
    <sys:Double x:Key="InventoryThumbnailSize">36</sys:Double>
    <sys:Double x:Key="ProductDialogWidth">836</sys:Double>
    <sys:Double x:Key="PaymentDialogWidth">640</sys:Double>
    <sys:Double x:Key="CompactDialogWidth">564</sys:Double>
    <sys:Double x:Key="SetupDialogWidth">1060</sys:Double>
    <sys:Double x:Key="BusinessSettingsCardWidth">1180</sys:Double>
    <sys:Double x:Key="BusinessSettingsContentWidth">1100</sys:Double>
    <sys:Double x:Key="BusinessSettingsTabHeight">650</sys:Double>
    <sys:Double x:Key="CategoryCardWidth">162</sys:Double>
    <sys:Double x:Key="CategoryImageHeight">78</sys:Double>
    <sys:Double x:Key="CategoryLabelHeight">42</sys:Double>
    <sys:Double x:Key="ProductCardWidth">186</sys:Double>
    <sys:Double x:Key="ProductImageHeight">92</sys:Double>
    <sys:Double x:Key="ProductLabelHeight">54</sys:Double>
    <sys:Double x:Key="ProductQuantityButtonSize">34</sys:Double>
    <sys:Double x:Key="RegisterTileTextSize">14</sys:Double>
    <sys:Double x:Key="RegisterTileIconSize">20</sys:Double>
    <sys:Double x:Key="ProductTileInitialsSize">28</sys:Double>

    <!-- ============ Palette: Modern, vibrant POS (light) ============ -->
    <Color x:Key="BgColor">#FFF1F5F9</Color>        <!-- app canvas: light slate -->
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>    <!-- cards: white -->
    <Color x:Key="Surface2Color">#FFEEF2F7</Color>   <!-- inputs / subtle fills -->
    <Color x:Key="BorderColor">#FFE2E8F0</Color>
    <Color x:Key="TextColor">#FF0F172A</Color>       <!-- dark slate -->
    <Color x:Key="MutedColor">#FF64748B</Color>      <!-- slate gray -->
    <Color x:Key="AccentColor">#FF2563EB</Color>     <!-- vivid blue (brand) -->
    <Color x:Key="SuccessColor">#FF15803D</Color>    <!-- green: cash / complete -->
    <Color x:Key="InfoColor">#FF0369A1</Color>       <!-- blue: card -->
    <Color x:Key="DangerColor">#FFB91C1C</Color>     <!-- red -->
    <Color x:Key="WarnColor">#FFF59E0B</Color>       <!-- amber: low stock -->

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SelectedNavTextBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="StopBrush" Color="#FFB91C1C" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />

    <!-- Brand gradient for the sidebar / hero accents -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2563EB" Offset="0" />
        <GradientStop Color="#FF1D4ED8" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <!-- ============ Text ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize26}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize13}" />
    </Style>

    <Style x:Key="Money" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize15}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BigMoney" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize44}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="None" />
        <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <!-- ============ Buttons ============ -->
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ButtonDisabledForeground" Color="#475569" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#7C8CA1" />
    <Style x:Key="ButtonFocus" TargetType="Control">
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="Control">
                <Grid Margin="-3" IsHitTestVisible="False">
                    <Border BorderBrush="White" BorderThickness="3" CornerRadius="12"/>
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12"/>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize15}" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocus}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12" />
                        <Border x:Name="State" CornerRadius="12" IsHitTestVisible="False"/>
                        <TextBlock x:Name="Caption" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Background" Value="#180F172A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="State" Property="Background" Value="#240F172A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource ButtonDisabledBackground}" />
                            <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource ButtonDisabledForeground}" />
                            <Setter TargetName="State" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize17}" />
        <Setter Property="Padding" Value="18,15" />
    </Style>

    <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource StopBrush}" />
    </Style>

    <Style x:Key="TableScanButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,28,0,8" />
        <Setter Property="MinWidth" Value="172" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{StaticResource StopBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource InfoBrush}" />
    </Style>

    <DataTemplate x:Key="ButtonCaption"><TextBlock FontFamily="{Binding FontFamily,RelativeSource={RelativeSource AncestorType=Button}}" Text="{Binding}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize,RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType=Button}}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate>
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource TextSize14}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocus}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12"
                            BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1">
                        <Grid>
                            <Border x:Name="State" CornerRadius="11" IsHitTestVisible="False" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Background" Value="#180F172A" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="State" Property="Background" Value="#240F172A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource ButtonDisabledBackground}" />
                            <Setter TargetName="State" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource ButtonDisabledForeground}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource StopButton}" />

    <Style x:Key="CatalogChoiceCard" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource TextSize15}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Card" Background="{TemplateBinding Background}" CornerRadius="12" Padding="12"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Effect"><Setter.Value><DropShadowEffect Color="#14273B" BlurRadius="14" ShadowDepth="3" Opacity="0.23"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DialogFit" TargetType="Viewbox">
        <Setter Property="StretchDirection" Value="DownOnly" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="14" />
    </Style>

    <Style x:Key="CaptionWindow" TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
        <Setter Property="layout:WindowCaption.Native" Value="True"/>
    </Style>
    <Style TargetType="Window" BasedOn="{StaticResource CaptionWindow}"/>
    <Style x:Key="FormDialogWindow" TargetType="Window" BasedOn="{StaticResource CaptionWindow}">
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
        <Setter Property="layout:DialogBounds.FitOwner" Value="True" />
    </Style>

    <!-- Content supplies initials. Tag supplies the decoded photo. -->
    <Style x:Key="CatalogThumbnail" TargetType="ContentControl">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="ThumbnailFrame" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                        <Grid>
                            <Rectangle x:Name="Photo" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Uniform" />
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="Initials" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="ThumbnailFrame" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Photo" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Initials" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Cards ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ============ Vibrant category palette (8 hues) ============ -->
    <SolidColorBrush x:Key="Cat0" Color="#FFEF4444" />  <!-- red -->
    <SolidColorBrush x:Key="Cat1" Color="#FF8B5CF6" />  <!-- violet -->
    <SolidColorBrush x:Key="Cat2" Color="#FFEC4899" />  <!-- pink -->
    <SolidColorBrush x:Key="Cat3" Color="#FFF59E0B" />  <!-- amber -->
    <SolidColorBrush x:Key="Cat4" Color="#FF10B981" />  <!-- emerald -->
    <SolidColorBrush x:Key="Cat5" Color="#FF3B82F6" />  <!-- blue -->
    <SolidColorBrush x:Key="Cat6" Color="#FF14B8A6" />  <!-- teal -->
    <SolidColorBrush x:Key="Cat7" Color="#FFF97316" />  <!-- orange -->

    <!-- ============ Status badges ============ -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeightDivider" TargetType="GridSplitter">
        <Setter Property="ResizeDirection" Value="Rows"/><Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="SizeNS"/><Setter Property="Focusable" Value="True"/><Setter Property="KeyboardIncrement" Value="12"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="ToolTip" Value="{loc:T Layout_ResizeHint}"/>
        <Setter Property="AutomationProperties.Name" Value="{loc:T Layout_ResizeHeight}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}"><Border x:Name="grip" Width="72" Height="3" CornerRadius="1.5" Background="{StaticResource BorderBrush}"/></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="grip" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="grip" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- ============ Tappable product / category tile ============ -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14"
                            BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="b" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

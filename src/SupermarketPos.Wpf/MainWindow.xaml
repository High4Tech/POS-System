<Window x:Class="SupermarketPos.Wpf.MainWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"
        Title="{Binding StoreProfile.Name}" Height="820" Width="1320" Style="{StaticResource CaptionWindow}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/app.ico"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        Language="{Binding Language, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="{DynamicResource UiFont}">

    <Window.Resources>
        <!-- Sidebar nav item: white text on the brand gradient, white pill when active -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="{DynamicResource TextSize15}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11"
                                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Background.Color, RelativeSource={RelativeSource TemplatedParent}}" Value="#FFFFFFFF">
                                <Setter TargetName="b" Property="Effect" Value="{StaticResource ButtonShadow}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="0,10" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Icon + localized label, both following the button's foreground -->
        <Style x:Key="NavText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>
        <Style x:Key="NavIcon" TargetType="TextBlock" BasedOn="{StaticResource NavText}">
            <Setter Property="FontSize" Value="{DynamicResource TextSize16}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource NavText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExpandedSidebarDetails" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarToggleButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="ToolTip" Value="{loc:T Nav_CollapseSidebar}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="ToolTip" Value="{loc:T Nav_ExpandSidebar}" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="ToolTip" Value="{loc:T Nav_WidenToExpand}" />
                    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PhoneScannerButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#6610204F" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,9,0,3" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8010204F" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#8010204F" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Shell: sidebar + content (visible once logged in) -->
        <Grid x:Name="Shell" SizeChanged="ShellSizeChanged"
              Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrandGradient}">
                <DockPanel Margin="12,12">
                    <StackPanel DockPanel.Dock="Top">
                        <Grid Margin="0,3,0,17">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource ExpandedSidebarDetails}" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Image Source="{Binding StoreProfile.LogoPath, Converter={StaticResource PathToImage}}"
                                           Visibility="{Binding StoreProfile.LogoPath, Converter={StaticResource HasImageToVis}}"
                                           Width="38" Height="38" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding StoreProfile.Name}" FontSize="{DynamicResource TextSize17}" FontWeight="Bold"
                                               Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               ToolTip="{Binding StoreProfile.Name}" />
                                </Grid>
                            </StackPanel>
                            <Button x:Name="SidebarToggle" Click="ToggleSidebar" Style="{StaticResource SidebarToggleButton}"
                                    AutomationProperties.Name="{Binding ToolTip, RelativeSource={RelativeSource Self}}">
                                <Path Width="18" Height="17" Stretch="Uniform" Stroke="White" StrokeThickness="1.35"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 2,1 L 14,1 Q 16,1 16,3 L 16,12 Q 16,14 14,14 L 2,14 Q 0,14 0,12 L 0,3 Q 0,1 2,1 Z M 5.2,1 L 5.2,14 M 2,4.4 L 3.1,4.4 M 2,7 L 3.1,7" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Button Command="{Binding LogoutCommand}" Style="{StaticResource NavButton}" Background="White"
                                Foreground="{StaticResource TextBrush}" ToolTip="{loc:T Nav_Logout}"
                                AutomationProperties.Name="{loc:T Nav_Logout}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource NavIcon}" />
                                <TextBlock Text="{loc:T Nav_Logout}" Style="{StaticResource NavLabel}" />
                            </DockPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Button Command="{Binding ShowDashboardCommand}" ToolTip="{loc:T Nav_Dashboard}" AutomationProperties.Name="{loc:T Nav_Dashboard}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="🏠" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Dashboard}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="dashboard">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowPosCommand}" ToolTip="{loc:T Nav_Pos}" AutomationProperties.Name="{loc:T Nav_Pos}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="🧾" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Pos}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="pos">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowProductsCommand}" ToolTip="{loc:T Nav_Products}" AutomationProperties.Name="{loc:T Nav_Products}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="📦" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Products}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="products">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowPurchasesCommand}" ToolTip="{loc:T Nav_Purchases}" AutomationProperties.Name="{loc:T Nav_Purchases}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="🚚" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Purchases}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="purchases">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowReportsCommand}" ToolTip="{loc:T Nav_Reports}" AutomationProperties.Name="{loc:T Nav_Reports}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="📊" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Reports}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="reports">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowCustomersCommand}" ToolTip="{loc:T Nav_Customers}" AutomationProperties.Name="{loc:T Nav_Customers}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="👥" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Customers}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="customers">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding ShowDigitalServicesCommand}" Visibility="{Binding DigitalServicesVisible,Converter={StaticResource BoolToVis}}" ToolTip="{loc:T Service_Title}">
                             <DockPanel><TextBlock DockPanel.Dock="Left" Text="▣" Style="{StaticResource NavIcon}"/><TextBlock Text="{loc:T Service_Title}" Style="{StaticResource NavLabel}"/></DockPanel>
                             <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveScreen}" Value="digital"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Command="{Binding ShowSettingsCommand}" ToolTip="{loc:T Nav_Settings}" AutomationProperties.Name="{loc:T Nav_Settings}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="⚙" Style="{StaticResource NavIcon}" />
                                    <TextBlock Text="{loc:T Nav_Settings}" Style="{StaticResource NavLabel}" />
                                </DockPanel>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveScreen}" Value="settings">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Command="{Binding Scanner.OpenPanelCommand}" Style="{StaticResource PhoneScannerButton}"
                                    ToolTip="{Binding Scanner.Status}" AutomationProperties.Name="{loc:T Scanner_Panel}"
                                    AutomationProperties.HelpText="{Binding Scanner.Status}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Fill="White" Width="14" Height="19" VerticalAlignment="Center" Stretch="Uniform"
                                          Data="F0 M 3,0 H 14 Q 17,0 17,3 V 20 Q 17,23 14,23 H 3 Q 0,23 0,20 V 3 Q 0,0 3,0 Z M 6,3 H 11 V 4 H 6 Z M 7,18 H 10 V 20 H 7 Z" />
                                    <StackPanel Style="{StaticResource ExpandedSidebarDetails}" Margin="10,0,0,0">
                                        <TextBlock Text="{loc:T Scanner_Panel}" Style="{StaticResource NavLabel}" />
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,2,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                         Fill="{Binding Foreground, ElementName=PhoneStatus}" />
                                                <TextBlock x:Name="PhoneStatus" FontSize="{DynamicResource TextSize12}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{loc:T Scanner_StatusDisconnected}" />
                                                            <Setter Property="Foreground" Value="#FFFFBFC4" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Scanner.IsConnected}" Value="True">
                                                                    <Setter Property="Text" Value="{loc:T Scanner_StatusConnected}" />
                                                                    <Setter Property="Foreground" Value="#FFA5F5C6" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Viewbox>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="8"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragCompleted="SidebarDragCompleted" KeyUp="SidebarResizeKeyUp"
                          ToolTip="{loc:T Nav_ResizeSidebar}" AutomationProperties.Name="{loc:T Nav_ResizeSidebar}">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="#FFDFE7F2" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- Content -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:T License_RecordsOnly}" TextWrapping="Wrap" Margin="18,12" Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"/>
                    <Border Style="{StaticResource Card}" Margin="16,8" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="{loc:T Updates_Download}" Command="{Binding DownloadSoftwareUpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="4"/>
                                <Button Content="{loc:T Updates_Later}" Command="{Binding RemindUpdateLaterCommand}" Style="{StaticResource GhostButton}" Margin="4"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
                <views:LowStockNotifications DataContext="{Binding StockAlerts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Grid.Row="1"
                                             AutomationProperties.LiveSetting="Polite">
                    <views:LowStockNotifications.Style>
                        <Style TargetType="views:LowStockNotifications">
                            <Setter Property="Margin" Value="12,12,20,16" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasAlerts}" Value="True" />
                                        <Condition Binding="{Binding DataContext.ShowLowStockNotifications, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:LowStockNotifications.Style>
                </views:LowStockNotifications>
            </Grid>
        </Grid>

        <!-- Login (full screen, while signed out) -->
        <ContentControl Content="{Binding Login}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}" />
    </Grid>
</Window>


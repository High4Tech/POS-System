<Window x:Class="SupermarketPos.Wpf.MainWindow" FontSize="{DynamicResource TextSize14}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SupermarketPos.Wpf.Localization"
        xmlns:views="clr-namespace:SupermarketPos.Wpf.Views"
        xmlns:common="clr-namespace:SupermarketPos.Wpf.Common"
        Height="820" Width="1320" Style="{StaticResource CaptionWindow}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Assets/app.ico"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationManager.Instance}}"
        Language="{Binding Language, Source={x:Static loc:LocalizationManager.Instance}}"
        FontFamily="{DynamicResource UiFont}">

    <Window.Title>
        <MultiBinding StringFormat="{}{0} · {1}"><Binding Source="{x:Static common:AppBrand.Name}"/><Binding Path="StoreProfile.Name"/></MultiBinding>
    </Window.Title>
    <Window.Resources>
        <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="{DynamicResource RegisterTileTextSize}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{StaticResource BrandGradient}" Padding="8,4">
              <DockPanel x:Name="NavigationBar" SizeChanged="FitNavigation">
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="{loc:T Common_More}" Style="{StaticResource TopButton}" Click="OpenMore"/>
                <Button x:Name="SettingsDestination" DockPanel.Dock="Right" Command="{Binding ShowSettingsCommand}" Content="{loc:T Nav_Settings}" Tag="settings">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="settings"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>
                <StackPanel x:Name="TopActions" DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Command="{Binding Scanner.OpenPanelCommand}" AutomationProperties.Name="{loc:T Scanner_Panel}" ToolTip="{Binding Scanner.Status}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}">
                      <Setter Property="Content" Value="{loc:T Scanner_StatusDisconnected}"/><Setter Property="Foreground" Value="#FFFFBFC4"/>
                      <Style.Triggers><DataTrigger Binding="{Binding Scanner.IsConnected}" Value="True">
                        <Setter Property="Content" Value="{loc:T Scanner_StatusConnected}"/><Setter Property="Foreground" Value="#FFA5F5C6"/>
                      </DataTrigger></Style.Triggers>
                    </Style></Button.Style>
                  </Button>
                </StackPanel>
                <StackPanel x:Name="Destinations" Orientation="Horizontal">
<Button Command="{Binding ShowDashboardCommand}" Content="{loc:T Nav_Dashboard}" Tag="dashboard">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="dashboard"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>
<Button Command="{Binding ShowPosCommand}" Content="{loc:T Nav_Pos}" Tag="pos">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="pos"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>

<Button x:Name="DigitalDestination" Tag="digital" Content="{loc:T Service_Title}" Command="{Binding ShowDigitalServicesCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveScreen}" Value="digital"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
<Button Command="{Binding ShowPurchasesCommand}" Content="{loc:T Nav_Purchases}" Tag="purchases">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="purchases"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>
<Button Command="{Binding ShowProductsCommand}" Content="{loc:T Nav_Products}" Tag="products">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="products"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>
<Button Command="{Binding ShowReportsCommand}" Content="{loc:T Nav_Reports}" Tag="reports">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="reports"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>
<Button Command="{Binding ShowCustomersCommand}" Content="{loc:T Nav_Customers}" Tag="customers">
    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TopButton}"><Style.Triggers>
      <DataTrigger Binding="{Binding ActiveScreen}" Value="customers"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource SelectedNavTextBrush}"/></DataTrigger>
    </Style.Triggers></Style></Button.Style>
</Button>


                </StackPanel>
              </DockPanel>
            </Border>
            <!-- Content -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ShortcutHint}" TextWrapping="Wrap" Margin="16,8,16,0"
                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource Muted}"
                               Visibility="{Binding ShortcutHint, Converter={StaticResource StrToVis}}"/>
                    <TextBlock Text="{loc:T License_RecordsOnly}" TextWrapping="Wrap" Margin="18,12" Foreground="{StaticResource DangerBrush}"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"/>
                    <Border Style="{StaticResource Card}" Margin="16,8" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="{loc:T Updates_Download}" Command="{Binding DownloadSoftwareUpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="4"/>
                                <Button Content="{loc:T Updates_Later}" Command="{Binding RemindUpdateLaterCommand}" Style="{StaticResource GhostButton}" Margin="4"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding UpdateMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="6"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
                <views:LowStockNotifications DataContext="{Binding StockAlerts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Grid.Row="1"
                                             AutomationProperties.LiveSetting="Polite">
                    <views:LowStockNotifications.Style>
                        <Style TargetType="views:LowStockNotifications">
                            <Setter Property="Margin" Value="12,12,20,16" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasAlerts}" Value="True" />
                                        <Condition Binding="{Binding DataContext.ShowLowStockNotifications, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:LowStockNotifications.Style>
                </views:LowStockNotifications>
            </Grid>
        </Grid>

        <!-- Login (full screen, while signed out) -->
        <ContentControl Content="{Binding Login}"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBoolToVis}}" />
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SupermarketPos.Application\SupermarketPos.Application.csproj" />
    <ProjectReference Include="..\SupermarketPos.Domain\SupermarketPos.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.*" />
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="..\..\assets\fonts\*.ttf" LogicalName="SupermarketPos.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\catalogs\DRAP_Complete_Medicine_Database.csv" LogicalName="SupermarketPos.Catalogs.DRAP.csv" Condition="'$(CommercialBuild)' != 'true' Or '$(MedicineCatalogRedistributionApproved)' == 'true'" />
    <EmbeddedResource Include="..\..\assets\catalogs\tech-retail\finance-v3.sqlite" LogicalName="SupermarketPos.Catalogs.Tech.Finance.sqlite" />
    <EmbeddedResource Include="..\..\assets\catalogs\tech-retail\hardware-v6.sqlite" LogicalName="SupermarketPos.Catalogs.Tech.Hardware.sqlite" />
    <EmbeddedResource Include="..\..\assets\catalogs\tech-retail\logos\**\*.png" LogicalName="SupermarketPos.Catalogs.Tech.Logos.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/panel"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/languageList"
            android:text="@string/language"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@id/languageList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:labelFor="@+id/methodList"
            android:text="@string/method"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@id/methodList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />
        <TextView
            android:id="@+id/guideText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bluetoothBtn"
            style="@style/Widget.PhoneScanner.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/os_bluetooth"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tetherBtn"
            style="@style/Widget.PhoneScanner.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/os_tether"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/device"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/deviceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connection_status"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/connectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/muted"
            android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connectBtn"
            style="@style/Widget.PhoneScanner.Action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/connect" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/manualPairBtn"
            style="@style/Widget.PhoneScanner.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/manual_pair" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgetBtn"
            style="@style/Widget.PhoneScanner.StopAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/forget" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/sound_title"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:textStyle="bold" />
        <CheckBox
            style="@style/Widget.PhoneScanner.SettingsCheckBox"
            android:id="@+id/soundCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_enabled" />
        <CheckBox
            style="@style/Widget.PhoneScanner.SettingsCheckBox"
            android:id="@+id/successCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound" />
        <CheckBox
            style="@style/Widget.PhoneScanner.SettingsCheckBox"
            android:id="@+id/connectionCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_connection" />
        <CheckBox
            style="@style/Widget.PhoneScanner.SettingsCheckBox"
            android:id="@+id/warningCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sound_warning" />
        <CheckBox
            style="@style/Widget.PhoneScanner.SettingsCheckBox"
            android:id="@+id/vibrateCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vibrate" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/volume"
            android:layout_marginTop="10dp"
            android:textSize="16sp"
            android:text="@string/sound_volume" />
        <SeekBar
            android:id="@id/volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/testSoundBtn"
            style="@style/Widget.PhoneScanner.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/sound_test" />
    </LinearLayout>
</ScrollView>
